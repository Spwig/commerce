#: api_views.py:40
msgid ""
"Returns all manual exchange rates for the current site. Staff authentication "
"required."
msgstr ""
"Restituisce tutte le valute di cambio manuali per il sito corrente. "
"Autenticazione dello staff richiesta."

#: api_views.py:46
msgid "Create a manual exchange rate"
msgstr "Crea una valuta di cambio manuale"

#: api_views.py:48
msgid ""
"Create a new manual exchange rate for a currency pair. Only one rate per "
"currency pair is allowed. Manual rates take precedence over provider rates "
"when active."
msgstr ""
"Crea un nuovo tasso di cambio manuale per una coppia di valute. È ammesso un "
"solo tasso per coppia di valute. I tassi manuali hanno la precedenza sui "
"tassi del fornitore quando attivi."

#: api_views.py:54
msgid "Rate created successfully"
msgstr "Valuta di cambio creata con successo"

#: api_views.py:56
msgid "Validation error (duplicate pair, invalid rate, etc.)"
msgstr "Errore di validazione (coppia duplicata, tasso non valido, ecc.)"

#: api_views.py:62
msgid "Get manual exchange rate details"
msgstr "Ottieni i dettagli della valuta di cambio manuale"

#: api_views.py:63
msgid "Retrieve a specific manual exchange rate by ID."
msgstr "Recupera una specifica valuta di cambio manuale per ID."

#: api_views.py:68
msgid "Update a manual exchange rate"
msgstr "Aggiorna una valuta di cambio manuale"

#: api_views.py:69
msgid "Fully update a manual exchange rate. All fields required."
msgstr ""
"Aggiorna completamente una valuta di cambio manuale. Tutti i campi richiesti."

#: api_views.py:72 api_views.py:85
msgid "Rate updated successfully"
msgstr "Valuta di cambio aggiornata con successo"

#: api_views.py:78
msgid "Partially update a manual exchange rate"
msgstr "Aggiorna parzialmente una valuta di cambio manuale"

#: api_views.py:80
msgid ""
"Update specific fields of a manual exchange rate. Commonly used to update "
"just the rate value."
msgstr ""
"Aggiorna campi specifici di una valuta di cambio manuale. Usato comunemente "
"per aggiornare solo il valore del tasso."

#: api_views.py:91
msgid "Delete a manual exchange rate"
msgstr "Elimina una valuta di cambio manuale"

#: api_views.py:93
msgid ""
"Permanently delete a manual exchange rate. The system will fall back to "
"provider rates for this currency pair."
msgstr ""
"Elimina definitivamente un tasso di cambio manuale. Il sistema passerà ai "
"tassi del fornitore per questa coppia di valute."

#: api_views.py:97
msgid "Rate deleted successfully"
msgstr "Valuta di cambio eliminata con successo"

#: api_views.py:143
msgid "Manual exchange rate created successfully."
msgstr "Tasso di cambio manuale creato con successo."

#: api_views.py:151
msgid "Failed to create manual exchange rate."
msgstr "Impossibile creare il tasso di cambio manuale."

#: api_views.py:172
msgid "Manual exchange rate updated successfully."
msgstr "Tasso di cambio manuale aggiornato con successo."

#: api_views.py:180
msgid "Failed to update manual exchange rate."
msgstr "Impossibile aggiornare il tasso di cambio manuale."

#: api_views.py:193
msgid "Manual exchange rate deleted successfully."
msgstr "Tasso di cambio manuale eliminato con successo."

#: api_views.py:199
msgid "Toggle manual rate active status"
msgstr "Attiva/Disattiva lo stato della valuta manuale"

#: api_views.py:201
msgid ""
"Toggle the active/inactive status of a manual exchange rate. When "
"deactivated, the system falls back to provider rates."
msgstr ""
"Attiva o disattiva lo stato di un tasso di cambio manuale. Quando "
"disattivato, il sistema passerà ai tassi del fornitore."

#: api_views.py:205
msgid "Status toggled successfully"
msgstr "Stato commutato con successo"

