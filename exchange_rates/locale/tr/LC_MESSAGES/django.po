msgstr "El ile kur başarıyla güncellendi."

#: api_views.py:180
msgid "Failed to update manual exchange rate."
msgstr "El ile döviz kuru güncellenemedi."

#: api_views.py:193
msgid "Manual exchange rate deleted successfully."
msgstr "El ile kur başarıyla silindi."

#: api_views.py:199
msgid "Toggle manual rate active status"
msgstr "Elle kur aktif durumunu değiştir"

#: api_views.py:201
msgid ""
"Toggle the active/inactive status of a manual exchange rate. When "
"deactivated, the system falls back to provider rates."
msgstr ""
"Bir manuel kurunun aktif/aktif olmayan durumunu değiştir. Devre dışı "
"bırakıldığında, sistem sağlayıcı kuruna geri döner."

#: api_views.py:205
msgid "Status toggled successfully"
msgstr "Durum başarıyla değiştirildi"

