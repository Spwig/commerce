msgstr ""
"Synchronisation terminée : %(created)d créé(s), %(updated)d mis(s) à jour, "
"%(skipped)d verrouillé(s) (ignoré(s))"

#: api_views.py:467 views/admin_views.py:591
msgid "An error occurred during sync."
msgstr "Une erreur s'est produite lors de la synchronisation."

