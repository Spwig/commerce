#: providers/fixer.py:316
msgid ""
"\n"
"        <h3>Fixer.io Setup</h3>\n"
"        <ol>\n"
"            <li>Sign up at <a href=\"https://fixer.io/product\" "
"target=\"_blank\">fixer.io/product</a></li>\n"
"            <li>Get your Access Key from the <a href=\"https://fixer.io/"
"dashboard\" target=\"_blank\">dashboard</a></li>\n"
"            <li>Enter your Access Key in the credentials field</li>\n"
"        </ol>\n"
"        <p><strong>Free Tier:</strong> 100 requests/month (sufficient for ~3 "
"daily updates)</p>\n"
"        <p><strong>Paid Plans:</strong> From $10/month for 1,000 requests</"
"p>\n"
"        <p><strong>Data Source:</strong> European Central Bank (ECB)</p>\n"
"        <p><strong>Note:</strong> Free tier only provides EUR as base "
"currency. Historical rates and custom base currencies require paid plans.</"
"p>\n"
"        <p><strong>Best For:</strong> EU-based stores requiring ECB "
"compliance</p>\n"
"        "
msgstr ""
"\n"
"        <h3>Pengaturan Fixer.io</h3> <ol> <li>Daftar di <a href=\"https://"
"fixer.io/product\" target=\"_blank\">fixer.io/product</a></li> <li>Dapatkan "
"Access Key Anda dari <a href=\"https://fixer.io/dashboard\" "
"target=\"_blank\">dashboard</a></li> <li>Masukkan Access Key Anda ke dalam "
"bidang kredensial</li> </ol> <p><strong>Tier Gratis:</strong> 100 permintaan/"
"bulan (cukup untuk ~3 pembaruan harian)</p> <p><strong>Rencana Berbayar:</"
"strong> Mulai dari $10/bulan untuk 1.000 permintaan</p> <p><strong>Sumber "
"Data:</strong> Bank Sentral Eropa (ECB)</p> <p><strong>Catatan:</strong> "
"Tier gratis hanya menyediakan EUR sebagai mata uang dasar. Tingkat historis "
"dan mata uang dasar khusus memerlukan rencana berbayar.</p> <p><strong>Tepat "
"Untuk:</strong> Toko berbasis EU yang memerlukan kepatuhan ECB</p>\n"
"        "

#: providers/openexchangerates.py:289
msgid ""
"\n"
"        <h3>Open Exchange Rates Setup</h3>\n"
"        <ol>\n"
"            <li>Sign up at <a href=\"https://openexchangerates.org/signup\" "
