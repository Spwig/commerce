#: providers/fixer.py:316
msgid ""
"\n"
"        <h3>Fixer.io Setup</h3>\n"
"        <ol>\n"
"            <li>Sign up at <a href=\"https://fixer.io/product\" "
"target=\"_blank\">fixer.io/product</a></li>\n"
"            <li>Get your Access Key from the <a href=\"https://fixer.io/"
"dashboard\" target=\"_blank\">dashboard</a></li>\n"
"            <li>Enter your Access Key in the credentials field</li>\n"
"        </ol>\n"
"        <p><strong>Free Tier:</strong> 100 requests/month (sufficient for ~3 "
"daily updates)</p>\n"
"        <p><strong>Paid Plans:</strong> From $10/month for 1,000 requests</"
"p>\n"
"        <p><strong>Data Source:</strong> European Central Bank (ECB)</p>\n"
"        <p><strong>Note:</strong> Free tier only provides EUR as base "
"currency. Historical rates and custom base currencies require paid plans.</"
"p>\n"
"        <p><strong>Best For:</strong> EU-based stores requiring ECB "
"compliance</p>\n"
"        "
msgstr ""
"\n"
"        <h3>การตั้งค่า Fixer.io</h3> <ol> <li>สมัครสมาชิกที่ <a href=\"https://"
"fixer.io/product\" target=\"_blank\">fixer.io/product</a></li> <li>รับ Access "
"Key จาก <a href=\"https://fixer.io/dashboard\" target=\"_blank\">แดชบอร์ด</"
"a></li> <li>กรอก Access Key ของคุณในช่องข้อมูลการรับรอง</li> </ol> "
"<p><strong>แผนฟรี:</strong> 100 คำขอต่อเดือน (เพียงพอสำหรับการอัปเดต ~3 ครั้งต่อวัน)</"
"p> <p><strong>แผนจ่ายเงิน:</strong> เริ่มต้นที่ $10/เดือนสำหรับ 1,000 คำขอ</p> "
"<p><strong>แหล่งข้อมูล:</strong> ธนาคารกลางยุโรป (ECB)</p> <p><strong>หมายเหตุ:</"
"strong> แผนฟรีมีเพียง EUR เป็นสกุลเงินพื้นฐานเท่านั้น "
"ข้อมูลอัตราแลกเปลี่ยนในอดีตและการใช้สกุลเงินพื้นฐานแบบกำหนดเองจำเป็นต้องใช้แผนจ่ายเงิน</p> "
"<p><strong>เหมาะสำหรับ:</strong> ร้านค้าที่ตั้งอยู่ในยุโรปที่ต้องการปฏิบัติตามข้อกำหนดของ "
"ECB</p>\n"
"        "

#: providers/openexchangerates.py:289
msgid ""
"\n"
"        <h3>Open Exchange Rates Setup</h3>\n"
"        <ol>\n"
"            <li>Sign up at <a href=\"https://openexchangerates.org/signup\" "
