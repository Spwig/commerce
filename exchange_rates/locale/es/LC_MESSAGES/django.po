#: providers/fixer.py:316
msgid ""
"\n"
"        <h3>Fixer.io Setup</h3>\n"
"        <ol>\n"
"            <li>Sign up at <a href=\"https://fixer.io/product\" "
"target=\"_blank\">fixer.io/product</a></li>\n"
"            <li>Get your Access Key from the <a href=\"https://fixer.io/"
"dashboard\" target=\"_blank\">dashboard</a></li>\n"
"            <li>Enter your Access Key in the credentials field</li>\n"
"        </ol>\n"
"        <p><strong>Free Tier:</strong> 100 requests/month (sufficient for ~3 "
"daily updates)</p>\n"
"        <p><strong>Paid Plans:</strong> From $10/month for 1,000 requests</"
"p>\n"
"        <p><strong>Data Source:</strong> European Central Bank (ECB)</p>\n"
"        <p><strong>Note:</strong> Free tier only provides EUR as base "
"currency. Historical rates and custom base currencies require paid plans.</"
"p>\n"
"        <p><strong>Best For:</strong> EU-based stores requiring ECB "
"compliance</p>\n"
"        "
msgstr ""
"\n"
"        <h3>Configuración de Fixer.io</h3> <ol> <li>Regístrese en <a "
"href=\"https://fixer.io/product\" target=\"_blank\">fixer.io/product</a></"
"li> <li>Obtenga su Clave de Acceso desde el <a href=\"https://fixer.io/"
"dashboard\" target=\"_blank\">dashboard</a></li> <li>Ingrese su Clave de "
"Acceso en el campo de credenciales</li> </ol> <p><strong>Plan Gratuito:</"
"strong> 100 solicitudes/mes (suficiente para ~3 actualizaciones diarias)</p> "
"<p><strong>Planes de Pago:</strong> Desde $10/mes para 1,000 solicitudes</p> "
"<p><strong>Fuente de Datos:</strong> Banco Central Europeo (BCE)</p> "
"<p><strong>Nota:</strong> El plan gratuito solo proporciona EUR como moneda "
"base. Las tasas históricas y monedas base personalizadas requieren planes de "
"pago.</p> <p><strong>Recomendado para:</strong> Tiendas basadas en la UE que "
"requieren cumplimiento con el BCE</p>\n"
"        "

#: providers/openexchangerates.py:289
