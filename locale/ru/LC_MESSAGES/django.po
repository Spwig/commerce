msgstr "Найдите 'Content API for Shopping'"

#: components_data/integrations/product_feed_provider/google_merchant/v1.0.0/setup_instructions.html:72
msgid "Click on it and then click 'Enable'"
msgstr "Нажмите на него, а затем нажмите 'Включить'"

