msgid "Click 'Add Key' → 'Create new key'"
msgstr "Нажмите 'Добавить ключ' → 'Создать новый ключ'"

#: components_data/integrations/product_feed_provider/google_merchant/v1.0.0/setup_instructions.html:54
msgid "Select 'JSON' format and click 'Create'"
msgstr "Выберите формат 'JSON' и нажмите 'Создать'"

