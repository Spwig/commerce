msgid "Sending Email:"
msgstr "Отправка электронной почты:"

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:15
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:15
msgid "SPF (Sender Policy Framework)"
msgstr "SPF (Sender Policy Framework)"

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:16
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:16
msgid ""
"SPF tells receiving mail servers which IP addresses are authorized to send "
"email from your domain."
msgstr ""
"SPF информирует почтовые сервера-получатели о том, какие IP-адреса "
"авторизованы для отправки электронной почты с вашего домена."

