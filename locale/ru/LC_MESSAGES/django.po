#: components_data/integrations/product_feed_provider/google_merchant/v1.0.0/setup_instructions.html:87
msgid "Click 'Add user'"
msgstr "Нажмите 'Добавить пользователя'"

#: components_data/integrations/product_feed_provider/google_merchant/v1.0.0/setup_instructions.html:85
msgid "Enter your service account email (from the JSON key)"
msgstr "Введите адрес электронной почты сервисного аккаунта (из JSON-ключа)"

#: components_data/integrations/product_feed_provider/google_merchant/v1.0.0/setup_instructions.html:86
