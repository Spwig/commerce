msgid "Invalid Customer Number"
msgstr "หมายเลขลูกค้าไม่ถูกต้อง"

#: components_data/integrations/shipping_provider/canadapost/v1.0.0/setup_instructions.html:485
#: components_data/integrations/shipping_provider/canadapost/v1.0.1/setup_instructions.html:485
#: components_data/integrations/shipping_provider/canadapost/v1.0.2/setup_instructions.html:485
msgid ""
"The customer number must be exactly 10 digits. Remove any spaces, dashes, or "
"other characters. Verify the number with Canada Post if you're unsure."
msgstr ""
"หมายเลขลูกค้าต้องมีทั้งหมด 10 หลัก ลบช่องว่าง ขีด หรือตัวอักษรต่างๆ ออก หากคุณไม่แน่ใจ "
"ให้ตรวจสอบหมายเลขกับ Canada Post"

#: components_data/integrations/shipping_provider/canadapost/v1.0.0/setup_instructions.html:489
#: components_data/integrations/shipping_provider/canadapost/v1.0.1/setup_instructions.html:489
#: components_data/integrations/shipping_provider/canadapost/v1.0.2/setup_instructions.html:489
msgid "No Rates Returned"
msgstr "ไม่มีค่าบริการที่คืนค่า"

#: components_data/integrations/shipping_provider/canadapost/v1.0.0/setup_instructions.html:490
