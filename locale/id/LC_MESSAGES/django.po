#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:53
msgid "Click 'Generate New Credentials' or 'Create API Key'"
msgstr "Klik 'Buat Kredensial Baru' atau 'Buat API Key'"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:54
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:54
msgid "You will receive an API Key (Client ID) and API Secret (Client Secret)"
msgstr "Anda akan menerima API Key (Client ID) dan API Secret (Client Secret)"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:55
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:55
msgid "Copy both values immediately - you'll need them in the next step"
msgstr ""
"Salin kedua nilai tersebut segera - Anda membutuhkannya dalam langkah "
"berikutnya"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:59
