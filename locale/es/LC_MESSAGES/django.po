msgstr "Seleccione las APIs que necesita (al menos: Ship, Track, Rates)"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:41
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:41
msgid "Accept the terms of service"
msgstr "Aceptar los términos del servicio"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:49
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:49
