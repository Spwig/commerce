#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:6
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:6
msgid ""
"Proper DNS configuration (SPF, DKIM, DMARC) prevents your emails from "
"landing in spam folders and ensures recipients can verify your emails are "
"legitimate. This is essential for transactional emails like order "
"confirmations and password resets."
msgstr ""
"Una configuración DNS adecuada (SPF, DKIM, DMARC) evita que tus correos "
"electrónicos terminen en la carpeta de spam y asegura que los destinatarios "
"puedan verificar que tus correos son legítimos. Esto es esencial para "
"correos electrónicos transaccionales como las confirmaciones de pedidos y "
"los restablecimientos de contraseña."

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:9
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:9
msgid "Your Domain:"
msgstr "Su dominio:"

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:10
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:10
msgid "Sending Email:"
msgstr "Enviando correo electrónico:"

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:15
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:15
msgid "SPF (Sender Policy Framework)"
msgstr "SPF (Sender Policy Framework)"

#: components_data/integrations/email_provider/gmail_api/v1.0.3/dns_requirements.html:16
#: components_data/integrations/email_provider/gmail_api/v1.0.4/dns_requirements.html:16
msgid ""
"SPF tells receiving mail servers which IP addresses are authorized to send "
"email from your domain."
msgstr ""
"SPF le indica a los servidores de correo electrónico receptores qué "
"direcciones IP están autorizadas para enviar correos electrónicos desde su "
"dominio."

