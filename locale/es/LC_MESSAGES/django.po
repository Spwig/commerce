#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:13
#, python-format
msgid ""
"Sign up for a free account at ExchangeRate-API. The free tier includes an "
"impressive 30,000 requests per month with 99.99%% uptime."
msgstr ""
"Regístrate en ExchangeRate-API para obtener una cuenta gratuita. La versión "
"gratuita incluye una impresionante cantidad de 30,000 solicitudes por mes "
"con un 99.99%% de tiempo de actividad."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:24
#: components_data/integrations/exchange_rate_provider/xe/v1.0.0/setup_instructions.html:55
#: components_data/integrations/exchange_rate_provider/xe/v1.0.1/setup_instructions.html:55
#: components_data/integrations/translation_provider/deepl/v1.0.0/setup_instructions.html:44
msgid "Get Your API Key"
msgstr "Obtener tu clave de API"

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:25
msgid ""
"Click 'Get Free API Key' on the homepage. Enter your email address and click "
"'Get Free Key'. You'll receive your API key immediately."
msgstr ""
"Haga clic en 'Obtener clave API gratuita' en la página de inicio. Ingrese su "
"dirección de correo electrónico y haga clic en 'Obtener clave gratuita'. "
"Recibirá su clave API de inmediato."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:28
msgid "No credit card required for the free tier!"
msgstr "¡No se requiere tarjeta de crédito para la capa gratuita!"

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:37
msgid ""
"Check your email inbox for a verification email from ExchangeRate-API. Click "
"the verification link to activate your account and access your dashboard."
msgstr ""
"Revise su bandeja de entrada de correo electrónico para un correo de "
"verificación de ExchangeRate-API. Haga clic en el enlace de verificación "
"para activar su cuenta y acceder a su panel."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:44
msgid "Copy Your API Key"
msgstr "Copiar tu clave de API"

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:45
msgid ""
"Your API Key is displayed on your dashboard. It's a 24-character "
"alphanumeric string."
msgstr ""
"Su API Key se muestra en su panel. Es una cadena alfanumérica de 24 "
"caracteres."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:51
msgid ""
"Keep your API Key secure. Never share it publicly or commit it to version "
"control."
msgstr ""
"Mantenga su API Key segura. Nunca comparta públicamente o la comprometa en "
"control de versiones."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:59
msgid "Paste Your API Key Below"
msgstr "Pegar tu clave de API a continuación"

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:60
msgid ""
"Enter your API Key in the credential form below and click 'Test Connection' "
"to verify it works correctly."
msgstr ""
"Ingrese su API Key en el formulario de credenciales a continuación y haga "
"clic en 'Probar conexión' para verificar que funcione correctamente."

#: components_data/integrations/exchange_rate_provider/exchangerate_api/v1.0.0/setup_instructions.html:71
msgid ""
"30,000 requests per month - one of the most generous free tiers available"
msgstr ""
"30,000 solicitudes por mes - una de las capas gratuitas más generosas "
"disponibles"

