msgstr "Abrir Portal del Desarrollador de FedEx"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:27
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:27
msgid "You'll need a valid email address and basic business information."
msgstr ""
"Necesitará una dirección de correo electrónico válida y información básica "
"de su negocio."

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:35
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:35
