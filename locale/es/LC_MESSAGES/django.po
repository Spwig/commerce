#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:53
msgid "Click 'Generate New Credentials' or 'Create API Key'"
msgstr "Haga clic en 'Generar nuevas credenciales' o 'Crear clave de API'"

#: components_data/integrations/shipping_provider/fedex/v1.1.0/setup_instructions.html:54
#: components_data/integrations/shipping_provider/fedex/v1.1.1/setup_instructions.html:54
msgid "You will receive an API Key (Client ID) and API Secret (Client Secret)"
msgstr ""
"Recibirá una clave de API (ID de cliente) y un secreto de API (Secreto de "
"cliente)"

