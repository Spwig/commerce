msgstr "التصفية حسب المصدر: 'الكل'، 'نموذج الاتصال'، 'ملاحظة الطلب'"

#: views/messages.py:301
msgid "Filter by status: 'all', 'unread', 'read', 'replied', 'archived'"
msgstr "التصفية حسب الحالة: 'الكل'، 'غير مقروء'، 'مقروء'، 'مردّد'، 'مُخزَّن'"

#: views/messages.py:309
msgid "Search by sender name, email, or subject"
msgstr "البحث حسب اسم المرسل، البريد الإلكتروني أو الموضوع"

#: views/messages.py:317
msgid ""
"Sort order: '-activity' (latest activity, default), '-created_at' (newest), "
"'created_at' (oldest), 'status' (group by status)"
msgstr ""
"ترتيب الفرز: '-activity' (النشاط الأخير، الافتراضي)، '-created_at' (الأحدث)،"
" 'created_at' (الأقدم)، 'status' (الترتيب حسب الحالة)"

#: views/messages.py:479
msgid "Get message details"
msgstr "الحصول على تفاصيل الرسالة"

#: views/messages.py:480
#, python-brace-format
msgid ""
"\n"
"    Get full details of a customer message.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"\n"
"    **URL Format:** `/messages/{source}/{id}/`\n"
"    - `source`: Either 'contact_form' or 'order_note'\n"
"    - `id`: The message ID within that source\n"
"\n"
"    Automatically marks the message as read if it was unread.\n"
"\n"
"    **Deep Linking:**\n"
"    - For `source='contact_form'`: Returns full contact form message\n"
"    - For `source='order_note'`: Returns order note with order info for linking\n"
"    "
msgstr ""
"\n"
"    احصل على تفاصيل كاملة لرسالة العميل.\n"
"\n"
"**محدودية المعدل:** 300 طلب في الدقيقة\n"
"\n"
"**تنسيق URL:** `/messages/{source}/{id}/`\n"
"- `source`: إما 'contact_form' أو 'order_note'\n"
"- `id`: معرف الرسالة داخل هذه المصادر\n"
"\n"
"يُشَيِّر تلقائيًا إلى أن الرسالة قُرئت إذا كانت غير مقروءة.\n"
"\n"
"**الروابط العميقة:**\n"
"- لـ `source='contact_form'`: يُعيد رسالة نموذج الاتصال الكاملة\n"
"- لـ `source='order_note'`: يُعيد ملاحظة الطلب مع معلومات الطلب لربطها\n"
"    "

#: views/messages.py:529 views/messages.py:557 views/messages.py:661
