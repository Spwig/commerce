#| msgid "List customer messages"
msgid "List staff members"
msgstr "कर्मचारी सदस्यों की सूची"

#: views/staff.py:45
msgid "List all staff members, paginated and filterable."
msgstr "सभी कर्मचारियों की सूची, पृष्ठ बंद और फ़िल्टर करने योग्य।"

#: views/staff.py:145
msgid "Invite a new staff member"
msgstr "एक नए कर्मचारी को आमंत्रित करें"

#: views/staff.py:146
msgid "Send an invitation email to a new staff member."
msgstr "एक नए कर्मचारी को आमंत्रण ईमेल भेजें।"

#: views/staff.py:169
#| msgid "Invalid variant data."
msgid "Invalid invitation data."
msgstr "अमान्य आमंत्रण डेटा।"

#: views/staff.py:186
msgid "This email is already registered as a staff member."
msgstr "यह ईमेल पहले से ही एक कर्मचारी के रूप में पंजीकृत है।"

#: views/staff.py:204
msgid "One or more role IDs are invalid."
msgstr "एक या अधिक भूमिका आईडी अमूल्य हैं।"

#: views/staff.py:287
#| msgid "Update tracking number"
msgid "Update a staff member"
msgstr "एक कर्मचारी को अपडेट करें"

#: views/staff.py:288
msgid "Update roles, status, or name of a staff member."
msgstr "एक कर्मचारी की भूमिका, स्थिति या नाम अपडेट करें।"

#: views/staff.py:313 views/staff.py:432
#| msgid "Order not found."
msgid "Staff member not found."
msgstr "कर्मचारी नहीं मिला।"

#: views/staff.py:327
msgid "Cannot modify the store owner."
msgstr "स्टोर मालिक को संशोधित नहीं किया जा सकता।"

#: views/staff.py:341
#| msgid "Invalid bulk update data."
msgid "Invalid update data."
msgstr "अमान्य अपडेट डेटा।"

#: views/staff.py:408
msgid "Remove a staff member"
msgstr "एक कर्मचारी हटाएं"

#: views/staff.py:409
msgid "Deactivate and revoke access for a staff member."
msgstr "एक कर्मचारी के लिए अक्षम करें और पहुंच वापस लें।"

#: views/staff.py:446
msgid "Cannot remove your own account."
msgstr "अपने खुद के खाता हटा नहीं सकते।"

#: views/staff.py:460
msgid "Cannot remove the store owner."
msgstr "स्टोर मालिक को हटा नहीं सकते।"

#: views/staff.py:497
msgid "Accept staff invitation"
msgstr "कर्मचारी आमंत्रण स्वीकृत करें"

#: views/staff.py:499
msgid ""
"GET: Validate an invitation token and return details. POST: Accept the "
"invitation by setting a password to create the staff account."
msgstr ""
"GET: एक आमंत्रण टोकन की जांच करें और विवरण लौटाएं। POST: एक पासवर्ड सेट करके"
" आमंत्रण को स्वीकृत करें ताकि कर्मचारी खाता बनाया जा सके।"

#: views/staff.py:521
#| msgid "Variant not found."
msgid "Invitation not found."
msgstr "आमंत्रण नहीं मिला।"

#: views/staff.py:534
#| msgid "This message has already been replied to."
msgid "This invitation has already been accepted."
msgstr "इस आमंत्रण को पहले से स्वीकृत कर दिया गया है।"

#: views/staff.py:547
#| msgid "Token has expired."
msgid "This invitation has expired."
msgstr "यह आमंत्रण अप्रभावी हो गया है।"

#: views/staff.py:589
#| msgid "Password has been reset successfully."
msgid "Password must be at least 8 characters."
msgstr "पासवर्ड कम से कम 8 अक्षर होना चाहिए।"

#: views/staff.py:603
#| msgid "An attribute with this name already exists."
msgid "An account with this email already exists."
msgstr "इस ईमेल से एक खाता पहले से ही मौजूद है।"

#: views/staff.py:648
msgid "Invitation accepted. You can now log in."
msgstr "आमंत्रण स्वीकृत कर लिया गया। अब आप लॉग इन कर सकते हैं।"

#: views/variants.py:48
msgid "List product variants"
msgstr "उत्पाद वेरिएंट सूची"

#: views/variants.py:49
msgid ""
"\n"
"    Get all variants for a specific product, with stock information.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"    "
msgstr ""
"\n"
"    एक विशिष्ट उत्पाद के सभी वेरिएंट्स प्राप्त करें, बिक्री के संबंधित जानकारी के साथ।\n"
"\n"
"**अनुमानित सीमा:** 300 अनुरोध प्रति मिनट\n"
"    "

#: views/variants.py:103
msgid "Create product variant"
msgstr "उत्पाद वेरिएंट बनाएं"

#: views/variants.py:104
msgid ""
"\n"
"    Create a new variant for a product. The product must be of type 'variable'.\n"
"    If `initial_stock` is provided and the product tracks inventory, a StockItem\n"
"    is auto-created for the default warehouse.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    एक उत्पाद के लिए एक नया वेरिएंट बनाएं। उत्पाद के प्रकार 'वेरिएबल' होना आवश्यक है।\n"
"यदि `initial_stock` प्रदान किया जाता है और उत्पाद इनवेंटरी के ट्रैक करता है, तो डिफ़ॉल्ट वर्कशॉप के लिए एक StockItem\n"
"स्वचालित रूप से बनाया जाता है।\n"
"\n"
"**अनुमानित सीमा:** 30 अनुरोध प्रति मिनट (संवेदनशील संचालन)\n"
"    "

#: views/variants.py:144
#, python-format
msgid ""
"Variants can only be added to variable products. This product is type "
"\"%(type)s\"."
msgstr ""
"वेरिएंट केवल वेरिएबल उत्पादों में जोड़े जा सकते हैं। यह उत्पाद प्रकार "
"\"%(type)s\" है।"

#: views/variants.py:160 views/variants.py:301
msgid "Invalid variant data."
msgstr "अमान्य वेरिएंट डेटा।"

#: views/variants.py:238
msgid "Variant created successfully."
msgstr "वेरिएंट सफलतापूर्वक बनाया गया।"

#: views/variants.py:247
msgid "Update product variant"
msgstr "उत्पाद वेरिएंट अपडेट करें"

#: views/variants.py:248
msgid ""
"\n"
"    Partially update a variant. Only provided fields will be changed.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    एक वेरिएंट को आंशिक रूप से अपडेट करें। केवल प्रदान किए गए क्षेत्र बदले जाएंगे।\n"
"\n"
"**दर सीमा:** 30 अनुरोध प्रति मिनट (संवेदनशील कार्य)\n"
"    "

#: views/variants.py:287 views/variants.py:419
msgid "Variant not found."
msgstr "वेरिएंट नहीं मिला।"

#: views/variants.py:375
msgid "Variant updated successfully."
msgstr "वेरिएंट सफलतापूर्वक अपडेट कर दिया गया।"

#: views/variants.py:384
msgid "Delete product variant"
msgstr "उत्पाद वेरिएंट हटाएं"

#: views/variants.py:385
msgid ""
"\n"
"    Permanently delete a variant. Associated StockItems will be cascade-deleted.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    एक वेरिएंट को निश्चित रूप से हटाएं। संबद्ध StockItems को कैसकेड डिलीट किया जाएगा।\n"
"\n"
"**दर सीमा:** 30 अनुरोध प्रति मिनट (संवेदनशील कार्य)\n"
"    "

#: views/variants.py:442
#, python-format
msgid "Variant \"%(name)s\" (%(sku)s) deleted successfully."
msgstr "वेरिएंट \"%(name)s\" (%(sku)s) सफलतापूर्वक हटा दिया गया।"

