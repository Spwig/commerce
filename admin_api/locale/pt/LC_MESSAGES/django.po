"            {\"attribute_id\": 1, \"value_ids\": [1, 2, 3], \"sort_order\": 0},\n"
"            {\"attribute_id\": 2, \"value_ids\": [5, 6], \"sort_order\": 1}\n"
"        ]\n"
"    }\n"
"    ```\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
