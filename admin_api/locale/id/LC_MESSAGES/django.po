msgstr "Informasi pelacakan telah diperbarui dengan sukses."

#: views/orders.py:645
msgid "Cancel order"
msgstr "Batalkan pesanan"

#: views/orders.py:646
msgid ""
"\n"
"    Cancel an order. This is a destructive action.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"\n"
"    Only orders in pending or processing status can be cancelled.\n"
"    "
msgstr ""
"\n"
"    Batalkan pesanan. Ini adalah tindakan yang merusak.\n"
"\n"
"**Batasi Tingkat:** 30 permintaan per menit (operasi sensitif)\n"
"\n"
"Hanya pesanan dengan status menunggu atau sedang diproses yang dapat dibatalkan.\n"
"    "

#: views/orders.py:690
msgid "Only pending or processing orders can be cancelled."
msgstr ""
