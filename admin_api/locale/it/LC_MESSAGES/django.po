"Fallimenti individuali non annullano l'intero lotto.\n"
"\n"
"**Limite di richieste:** 30 richieste al minuto (operazione sensibile)\n"
"    "

#: views/products.py:1860
msgid "Invalid bulk update data."
msgstr "Dati di aggiornamento in blocco non validi."

#: views/products.py:1958
#, python-format
msgid "Updated %(updated)d product(s). %(errors)d failed."
msgstr "Aggiornati %(updated)d prodotto(i). %(errors)d falliti."

