msgstr "Richiesta di assegnazione tag di massa non valida."

#: views/bulk_products.py:640
#| msgid "Bulk update products"
msgid "Bulk sale update"
msgstr "Aggiornamento vendita di massa"

#: views/bulk_products.py:641
msgid ""
"\n"
"    Update sale settings for multiple products in a single request.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"\n"
"    Maximum 100 products per request.\n"
"\n"
"    **Sale types:**\n"
"    - none: Clear sale (removes all sale settings)\n"
"    - fixed_price: Set a fixed sale price\n"
"    - amount_off: Subtract a fixed amount from the base price\n"
"    - percentage_off: Apply a percentage discount off the base price\n"
"\n"
"    Optionally set sale_start_date and sale_end_date to schedule the sale.\n"
"    "
msgstr ""
"\n"
"    Aggiorna le impostazioni di vendita per diversi prodotti in una singola richiesta.\n"
"\n"
"**Limite di richieste:** 30 richieste al minuto (operazione sensibile)\n"
"\n"
"Massimo 100 prodotti per richiesta.\n"
"\n"
"**Tipi di vendita:**\n"
"- none: Rimuovi la vendita (elimina tutte le impostazioni di vendita)\n"
"- fixed_price: Imposta un prezzo fisso per la vendita\n"
"- amount_off: Sottrai un importo fisso dal prezzo base\n"
"- percentage_off: Applica uno sconto in percentuale sul prezzo base\n"
"\n"
"Opzionalmente imposta sale_start_date e sale_end_date per pianificare la vendita.\n"
"    "

