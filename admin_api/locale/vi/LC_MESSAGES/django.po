msgstr "Ngày kết thúc giai đoạn so sánh (YYYY-MM-DD)"

#: views/analytics.py:1136
msgid "Export analytics report"
msgstr "Xuất báo cáo phân tích"

#: views/analytics.py:1137
msgid ""
"\n"
"    Export analytics data as CSV or PDF.\n"
"\n"
