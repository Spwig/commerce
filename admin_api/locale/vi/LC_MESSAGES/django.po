"    "

#: views/settings.py:514
msgid "Cannot revoke current device session. Use logout instead."
msgstr ""
"Không thể thu hồi phiên làm việc của thiết bị hiện tại. Vui lòng sử dụng "
"chức năng đăng xuất thay vào đó."

#: views/settings.py:527
msgid "Session revoked successfully."
msgstr "Phiên đã được hủy thành công."

#: views/settings.py:533
msgid "Get available languages"
msgstr "Lấy danh sách ngôn ngữ có sẵn"

#: views/settings.py:534
msgid ""
"\n"
"    Get list of available languages for the app.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"    "
msgstr ""
"\n"
"    Lấy danh sách các ngôn ngữ có sẵn cho ứng dụng.\n"
"\n"
"**Giới hạn tốc độ:** 300 yêu cầu mỗi phút\n"
"    "

#: views/sso.py:66
msgid "Get SSO configuration"
msgstr "Lấy cấu hình SSO"

#: views/sso.py:67
msgid ""
"\n"
"    Check if SSO is enabled and get provider details.\n"
"\n"
"    **Public** — no authentication required.\n"
"    Called by the iOS app on login screen load to decide whether to show the SSO button.\n"
"    "
msgstr ""
"\n"
"    Kiểm tra xem SSO đã được bật hay chưa và lấy chi tiết nhà cung cấp.\n"
"\n"
"**Công khai** — không yêu cầu xác thực.\n"
"Được gọi bởi ứng dụng iOS khi tải màn hình đăng nhập để quyết định có hiển thị nút SSO hay không.\n"
"    "

#: views/sso.py:97
msgid "Initiate SSO login"
msgstr "Khởi tạo đăng nhập SSO"

#: views/sso.py:98
msgid ""
"\n"
"    Start the OIDC authorization flow for mobile SSO.\n"
"\n"
"    **Public** — no authentication required.\n"
"    The iOS app opens this URL in ASWebAuthenticationSession. Returns a 302 redirect\n"
"    to the identity provider's authorization endpoint.\n"
"    "
msgstr ""
"\n"
"    Khởi động quy trình ủy quyền OIDC cho SSO di động.\n"
"\n"
"**Công khai** — không yêu cầu xác thực.\n"
"Ứng dụng iOS mở URL này trong ASWebAuthenticationSession. Trả về chuyển hướng 302\n"
"tới điểm cuối ủy quyền của nhà cung cấp danh tính.\n"
"    "

#: views/sso.py:131
msgid "device_id parameter is required and must be a valid identifier."
msgstr "Tham số device_id là bắt buộc và phải là một định danh hợp lệ."

#: views/sso.py:145
msgid "SSO is not enabled or not configured."
msgstr "SSO chưa được kích hoạt hoặc chưa được cấu hình."

#: views/sso.py:352
msgid "Exchange SSO code for tokens"
msgstr "Đổi mã SSO lấy token"

#: views/sso.py:353
msgid ""
"\n"
"    Exchange a one-time SSO code for access/refresh tokens.\n"
"\n"
"    **Public** — no authentication required.\n"
"    Called by the iOS app after receiving the one-time code from the SSO callback redirect.\n"
"    Returns the same response shape as the password login endpoint.\n"
"    "
msgstr ""
"\n"
"    Trao đổi mã SSO một lần để nhận token truy cập/refresh.\n"
"\n"
"**Công khai** — không yêu cầu xác thực.\n"
"Được gọi bởi ứng dụng iOS sau khi nhận được mã một lần từ chuyển hướng callback SSO.\n"
"Trả về cùng định dạng phản hồi như endpoint đăng nhập mật khẩu.\n"
"    "

#: views/sso.py:397
msgid "code and a valid device_id are required."
msgstr "code và một device_id hợp lệ là bắt buộc."

#: views/sso.py:413 views/sso.py:427 views/sso.py:465
msgid "Invalid or expired SSO code."
msgstr "Mã SSO không hợp lệ hoặc đã hết hạn."

#: views/sso.py:446
msgid "Device mismatch."
msgstr "Không khớp thiết bị."

#: views/sso.py:491
msgid "User is not authorized."
msgstr "Người dùng không được ủy quyền."

#: views/sso.py:526
msgid "Maximum device limit reached. Please logout from another device."
msgstr ""
"Đã đạt giới hạn thiết bị tối đa. Vui lòng đăng xuất khỏi thiết bị khác."

#: views/staff.py:44
#| msgid "List customer messages"
msgid "List staff members"
msgstr "Liệt kê nhân viên"

#: views/staff.py:45
msgid "List all staff members, paginated and filterable."
msgstr ""
"Liệt kê tất cả các thành viên nhân viên, có phân trang và khả năng lọc."

#: views/staff.py:145
msgid "Invite a new staff member"
msgstr "Mời nhân viên mới"

#: views/staff.py:146
msgid "Send an invitation email to a new staff member."
msgstr "Gửi email mời một thành viên nhân sự mới."

#: views/staff.py:169
#| msgid "Invalid variant data."
msgid "Invalid invitation data."
msgstr "Dữ liệu lời mời không hợp lệ."

#: views/staff.py:186
msgid "This email is already registered as a staff member."
msgstr "Email này đã được đăng ký là một thành viên nhân sự."

#: views/staff.py:204
msgid "One or more role IDs are invalid."
msgstr "Một hoặc nhiều ID vai trò không hợp lệ."

#: views/staff.py:287
#| msgid "Update tracking number"
msgid "Update a staff member"
msgstr "Cập nhật nhân viên"

#: views/staff.py:288
msgid "Update roles, status, or name of a staff member."
msgstr "Cập nhật vai trò, trạng thái hoặc tên của một thành viên nhân sự."

#: views/staff.py:313 views/staff.py:432
#| msgid "Order not found."
msgid "Staff member not found."
msgstr "Không tìm thấy nhân viên."

#: views/staff.py:327
msgid "Cannot modify the store owner."
msgstr "Không thể chỉnh sửa chủ cửa hàng."

#: views/staff.py:341
#| msgid "Invalid bulk update data."
msgid "Invalid update data."
msgstr "Dữ liệu cập nhật không hợp lệ."

#: views/staff.py:408
msgid "Remove a staff member"
msgstr "Xóa nhân viên"

#: views/staff.py:409
msgid "Deactivate and revoke access for a staff member."
msgstr "Tạm dừng và thu hồi quyền truy cập của một thành viên nhân sự."

#: views/staff.py:446
msgid "Cannot remove your own account."
msgstr "Không thể xóa tài khoản của chính bạn."

#: views/staff.py:460
msgid "Cannot remove the store owner."
msgstr "Không thể xóa chủ cửa hàng."

#: views/staff.py:497
msgid "Accept staff invitation"
msgstr "Chấp nhận lời mời tham gia"

#: views/staff.py:499
msgid ""
"GET: Validate an invitation token and return details. POST: Accept the "
"invitation by setting a password to create the staff account."
msgstr ""
"GET: Xác minh token mời và trả về chi tiết. POST: Chấp nhận lời mời bằng "
"cách đặt mật khẩu để tạo tài khoản nhân viên."

#: views/staff.py:521
#| msgid "Variant not found."
msgid "Invitation not found."
msgstr "Không tìm thấy lời mời."

#: views/staff.py:534
#| msgid "This message has already been replied to."
msgid "This invitation has already been accepted."
msgstr "Lời mời này đã được chấp nhận."

#: views/staff.py:547
#| msgid "Token has expired."
msgid "This invitation has expired."
msgstr "Lời mời này đã hết hạn."

#: views/staff.py:589
#| msgid "Password has been reset successfully."
msgid "Password must be at least 8 characters."
msgstr "Mật khẩu phải có ít nhất 8 ký tự."

#: views/staff.py:603
#| msgid "An attribute with this name already exists."
msgid "An account with this email already exists."
msgstr "Tài khoản với địa chỉ email này đã tồn tại."

#: views/staff.py:648
msgid "Invitation accepted. You can now log in."
msgstr "Lời mời đã được chấp nhận. Bạn có thể đăng nhập bây giờ."

#: views/variants.py:48
msgid "List product variants"
msgstr "Danh sách biến thể sản phẩm"

#: views/variants.py:49
msgid ""
"\n"
"    Get all variants for a specific product, with stock information.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"    "
msgstr ""
"\n"
"    Lấy tất cả các biến thể của một sản phẩm cụ thể, kèm thông tin tồn kho.\n"
"\n"
"**Giới hạn tốc độ:** 300 yêu cầu mỗi phút\n"
"    "

#: views/variants.py:103
msgid "Create product variant"
msgstr "Tạo biến thể sản phẩm"

#: views/variants.py:104
msgid ""
"\n"
"    Create a new variant for a product. The product must be of type 'variable'.\n"
"    If `initial_stock` is provided and the product tracks inventory, a StockItem\n"
"    is auto-created for the default warehouse.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    Tạo một biến thể mới cho một sản phẩm. Sản phẩm phải có loại là 'variable'.\n"
"Nếu `initial_stock` được cung cấp và sản phẩm theo dõi tồn kho, một StockItem\n"
"sẽ được tạo tự động cho kho mặc định.\n"
"\n"
"**Giới hạn tốc độ:** 30 yêu cầu mỗi phút (thao tác nhạy cảm)\n"
"    "

#: views/variants.py:144
#, python-format
msgid ""
"Variants can only be added to variable products. This product is type "
"\"%(type)s\"."
msgstr ""
"Các biến thể chỉ có thể được thêm vào sản phẩm biến thể. Sản phẩm này là "
"loại \"%(type)s\"."

#: views/variants.py:160 views/variants.py:301
msgid "Invalid variant data."
msgstr "Dữ liệu biến thể không hợp lệ."

#: views/variants.py:238
msgid "Variant created successfully."
msgstr "Biến thể đã được tạo thành công."

#: views/variants.py:247
msgid "Update product variant"
msgstr "Cập nhật biến thể sản phẩm"

#: views/variants.py:248
msgid ""
"\n"
"    Partially update a variant. Only provided fields will be changed.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    Cập nhật một biến thể một phần. Chỉ các trường được cung cấp sẽ được thay đổi.\n"
"\n"
"**Giới hạn tốc độ:** 30 yêu cầu mỗi phút (thao tác nhạy cảm)\n"
"    "

#: views/variants.py:287 views/variants.py:419
msgid "Variant not found."
msgstr "Không tìm thấy biến thể."

#: views/variants.py:375
msgid "Variant updated successfully."
msgstr "Biến thể đã được cập nhật thành công."

#: views/variants.py:384
msgid "Delete product variant"
msgstr "Xóa biến thể sản phẩm"

#: views/variants.py:385
msgid ""
"\n"
"    Permanently delete a variant. Associated StockItems will be cascade-deleted.\n"
"\n"
"    **Rate Limit:** 30 requests per minute (sensitive operation)\n"
"    "
msgstr ""
"\n"
"    Xóa vĩnh viễn một biến thể. Các mục tồn kho liên quan sẽ bị xóa theo chuỗi.\n"
"\n"
"**Giới hạn tốc độ:** 30 yêu cầu mỗi phút (thao tác nhạy cảm)\n"
"    "

