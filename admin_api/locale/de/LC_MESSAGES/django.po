msgstr "Ungültige Neuanordnungsanfrage."

#: views/products.py:1251
msgid "Some image IDs do not belong to this product."
msgstr "Einige Bild-IDs gehören zu diesem Produkt nicht."

#: views/products.py:1283
msgid "Images reordered successfully."
msgstr "Bilder erfolgreich neu geordnet."

#: views/products.py:1292
