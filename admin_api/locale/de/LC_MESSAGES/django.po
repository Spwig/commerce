msgstr ""
"Ein Erstattungsverfahren für diese Bestellung ist bereits in Bearbeitung."

#: views/orders.py:955
msgid "Refund initiated successfully."
msgstr "Rückerstattung erfolgreich gestartet."

#: views/orders.py:964
msgid "Get order counts by status"
msgstr "Bestellzahlen nach Status abrufen"

#: views/orders.py:965
msgid ""
"\n"
"    Get count of orders by status for badge display.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"    "
msgstr ""
"\n"
"    Zählen der Bestellungen nach Status für die Anzeige auf dem Badge.\n"
"\n"
"**Rate Limit:** 300 Anfragen pro Minute\n"
"    "

#: views/products.py:57
msgid "List products"
msgstr "Produkte auflisten"

#: views/products.py:58
#| msgid ""
#| "\n"
#| "    Get a paginated list of products with filtering and sorting.\n"
#| "\n"
#| "    **Rate Limit:** 300 requests per minute\n"
#| "\n"
#| "    **Stock Status Filter:**\n"
#| "    - all: All products (default)\n"
#| "    - in_stock: Products with available stock > low_stock_threshold\n"
#| "    - low_stock: Products with 0 < available stock <= low_stock_threshold\n"
#| "    - out_of_stock: Products with available stock <= 0\n"
#| "\n"
#| "    **Sort Options (use 'ordering' parameter):**\n"
#| "    - name: Name A-Z\n"
#| "    - -name: Name Z-A\n"
#| "    - -created_at: Newest first\n"
#| "    - created_at: Oldest first\n"
#| "    - stock_quantity: Lowest stock first\n"
#| "    - -stock_quantity: Highest stock first\n"
#| "    "
msgid ""
"\n"
"    Get a paginated list of products with filtering and sorting.\n"
"\n"
"    **Rate Limit:** 300 requests per minute\n"
"\n"
"    **Stock Status Filter:**\n"
"    - all: All products (default)\n"
"    - in_stock: Products with available stock > low_stock_threshold\n"
"    - low_stock: Products with 0 < available stock <= low_stock_threshold\n"
"    - out_of_stock: Products with available stock <= 0\n"
"\n"
"    **Sort Options (use 'ordering' parameter):**\n"
"    - name: Name A-Z\n"
"    - -name: Name Z-A\n"
"    - -created_at: Newest first\n"
"    - created_at: Oldest first\n"
"    - stock_quantity: Lowest stock first\n"
"    - -stock_quantity: Highest stock first\n"
"    - price: Price low to high\n"
"    - -price: Price high to low\n"
"    - -updated_at: Recently updated first\n"
"    - updated_at: Least recently updated first\n"
"    "
msgstr ""
"\n"
"    Erhalte eine aufgeschlüsselte Liste von Produkten mit Filterung und Sortierung.\n"
"\n"
"**Rate Limit:** 300 Anfragen pro Minute\n"
"\n"
"**Lagerstatus-Filter:**\n"
"- all: Alle Produkte (Standard)\n"
"- in_stock: Produkte mit verfügbarer Menge > low_stock_threshold\n"
"- low_stock: Produkte mit 0 < verfügbare Menge <= low_stock_threshold\n"
"- out_of_stock: Produkte mit verfügbarer Menge <= 0\n"
"\n"
"**Sortierungsoptionen (verwende den Parameter 'ordering'):**\n"
"- name: Name A-Z\n"
"- -name: Name Z-A\n"
"- -created_at: Neueste zuerst\n"
"- created_at: Älteste zuerst\n"
"- stock_quantity: Niedrigster Lagerbestand zuerst\n"
"- -stock_quantity: Höchster Lagerbestand zuerst\n"
"- price: Preis von niedrig nach hoch\n"
"- -price: Preis von hoch nach niedrig\n"
"- -updated_at: Kürzlich aktualisiert zuerst\n"
"- updated_at: Wenigstens aktualisiert zuerst\n"
"    "

#: views/products.py:86
msgid "Filter by product status: 'all', 'draft', 'published', 'discontinued'"
msgstr ""
"Nach Produktstatus filtern: 'all', 'draft', 'published', 'discontinued'"

#: views/products.py:94
