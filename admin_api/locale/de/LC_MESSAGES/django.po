msgstr "Ungültige Aktualisierungsanfrage."

#: views/products.py:1387
msgid "Image updated successfully."
msgstr "Bild erfolgreich aktualisiert."

#: views/products.py:1474
msgid "Create product"
msgstr "Produkt erstellen"

