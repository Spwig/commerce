msgid ""
"OIDC claim field for group memberships (leave blank to disable group mapping)"
msgstr ""
"حقل ادعاء OIDC للعضويات في المجموعة (اتركه فارغًا لتعطيل خريطة المجموعة)"

#: models.py:110
msgid "Staff Groups"
msgstr "مجموعات الموظفين"

