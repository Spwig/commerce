msgstr "Gelişmiş"

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:90
msgid "Identity Provider"
msgstr "Kimlik Sağlayıcısı"

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:102
msgid ""
"Enter the OIDC Discovery URL and click Auto-Discover to populate the "
"endpoint fields automatically."
msgstr ""
"OIDC Keşif URL'sini girin ve otomatik keşfetme butonuna tıklayarak uç nokta "
"alanlarını otomatik olarak doldurun."

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:111
msgid "Please enter a Discovery URL first."
msgstr "İlk olarak bir Keşif URL'si girin."

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:112
msgid "Discovering..."
msgstr "Keşfediliyor..."

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:113
msgid "Discovery failed:"
msgstr "Keşif başarısız oldu:"

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:114
msgid "Discovery successful!"
msgstr "Keşif Başarılı!"

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:115
msgid "endpoints populated."
msgstr "uç noktaları dolduruldu."

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:116
msgid "Discovery request failed:"
msgstr "Keşif isteği başarısız oldu:"

#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:117
msgid "Auto-Discover"
msgstr "Otomatik Keşfet"

