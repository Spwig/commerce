msgid "Scopes & Behavior"
msgstr "範圍與行為"

#: models.py:23
msgid "Provider Name"
msgstr "提供者名稱"

#: models.py:25
msgid ""
"Display name for the SSO button, e.g. 'Microsoft', 'Okta', 'Google Workspace'"
msgstr "SSO 按鈕的顯示名稱，例如 'Microsoft'、'Okta'、'Google Workspace'\""

#: models.py:33
msgid "OIDC Discovery URL"
msgstr "OIDC 發現 URL"

#: models.py:35
#, python-brace-format
msgid ""
"OpenID Connect discovery endpoint (e.g. https://login.microsoftonline.com/"
"{tenant}/v2.0/.well-known/openid-configuration)"
msgstr ""
"OpenID Connect 發現端點（例如 https://login.microsoftonline.com/{tenant}/"
"v2.0/.well-known/openid-configuration）"

#: models.py:41
msgid "Authorization Endpoint"
msgstr "授權端點"

#: models.py:46
msgid "Token Endpoint"
msgstr "令牌端點"

#: models.py:51
msgid "UserInfo Endpoint"
msgstr "用戶資訊端點"

#: models.py:56
msgid "JWKS Endpoint"
msgstr "JWKS 端點"

#: models.py:61
msgid "End Session Endpoint"
msgstr "結束會話端點"

#: models.py:62
msgid "Used for single sign-out (optional)"
msgstr "用於單一登出（可選）"

#: models.py:69
msgid "Client ID"
msgstr "客戶端 ID"

#: models.py:70
msgid "Application/Client ID from your identity provider"
msgstr "來自您的身份提供者的應用程式/客戶端 ID\""

#: models.py:75
msgid "Client Secret (Encrypted)"
msgstr "客戶端密碼（加密）"

#: models.py:82
msgid "Email Claim"
msgstr "電子郵件聲明"

#: models.py:83
msgid "OIDC claim field for user email address"
msgstr "用於用戶電子郵件地址的 OIDC 声明欄位\""

#: models.py:88
msgid "First Name Claim"
msgstr "名字聲明"

#: models.py:89
msgid "OIDC claim field for first name"
msgstr "OIDC 声明欄位用於名字"

#: models.py:94
msgid "Last Name Claim"
msgstr "姓氏聲明"

#: models.py:95
msgid "OIDC claim field for last name"
msgstr "OIDC 声明欄位用於姓氏"

#: models.py:101
msgid "Groups Claim"
msgstr "群組聲明"

#: models.py:103
msgid ""
"OIDC claim field for group memberships (leave blank to disable group mapping)"
msgstr "OIDC 声明欄位用於群組成員資格（留空以禁用群組映射）"

#: models.py:110
msgid "Staff Groups"
msgstr "工作人員群組"

#: models.py:111
msgid "Comma-separated group names or IDs that grant staff status"
msgstr "以逗號分隔的群組名稱或 ID，用於授予工作人員狀態"

#: models.py:115
msgid "Superuser Groups"
msgstr "超級用戶群組"

#: models.py:116
msgid "Comma-separated group names or IDs that grant superuser status"
msgstr "以逗號分隔的群組名稱或 ID，用於授予超級用戶狀態"

#: models.py:123
msgid "OIDC Scopes"
msgstr "OIDC 范圍"

#: models.py:124
msgid "Space-separated OIDC scopes to request"
msgstr "以空格分隔的 OIDC 范圍請求"

#: models.py:130
msgid "Auto-Create Users"
msgstr "自動創建用戶"

#: models.py:132
msgid ""
"Automatically create a user account when an SSO user signs in for the first "
"time"
msgstr "當 SSO 用戶首次登入時，自動創建用戶帳號"

#: models.py:137
msgid "Restrict to Staff"
msgstr "限制為工作人員"

#: models.py:139
msgid ""
"Only allow existing staff users to sign in via SSO. Disable to allow SSO "
"user auto-creation."
msgstr "僅允許現有的工作人員用戶通過 SSO 登入。停用以允許自動創建 SSO 用戶。"

