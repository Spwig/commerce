msgstr "역할 매핑"

#: admin.py:117
#: templates/admin/enterprise_sso/ssoproviderconfig/change_form.html:270
msgid "Scopes & Behavior"
msgstr "범위 및 행동"

#: models.py:23
msgid "Provider Name"
msgstr "공급업체 이름"

#: models.py:25
msgid ""
"Display name for the SSO button, e.g. 'Microsoft', 'Okta', 'Google Workspace'"
msgstr "SSO 버튼의 표시 이름, 예: 'Microsoft', 'Okta', 'Google Workspace'"

#: models.py:33
msgid "OIDC Discovery URL"
msgstr "OIDC 발견 URL"

#: models.py:35
#, python-brace-format
msgid ""
"OpenID Connect discovery endpoint (e.g. https://login.microsoftonline.com/"
"{tenant}/v2.0/.well-known/openid-configuration)"
msgstr ""
"OpenID Connect 발견 엔드포인트 (예: https://login.microsoftonline.com/"
"{tenant}/v2.0/.well-known/openid-configuration)"

#: models.py:41
msgid "Authorization Endpoint"
msgstr "인증 엔드포인트"

#: models.py:46
msgid "Token Endpoint"
msgstr "토큰 엔드포인트"

#: models.py:51
msgid "UserInfo Endpoint"
msgstr "사용자 정보 엔드포인트"

#: models.py:56
msgid "JWKS Endpoint"
msgstr "JWKS 엔드포인트"

#: models.py:61
msgid "End Session Endpoint"
msgstr "세션 종료 엔드포인트"

#: models.py:62
msgid "Used for single sign-out (optional)"
msgstr "단일 로그아웃용 (선택 사항)"

#: models.py:69
msgid "Client ID"
msgstr "클라이언트 ID"

#: models.py:70
msgid "Application/Client ID from your identity provider"
msgstr "식별 제공자의 애플리케이션/클라이언트 ID"

#: models.py:75
msgid "Client Secret (Encrypted)"
msgstr "클라이언트 비밀 (암호화됨)"

#: models.py:82
msgid "Email Claim"
msgstr "이메일 클레임"

#: models.py:83
msgid "OIDC claim field for user email address"
msgstr "사용자 이메일 주소를 위한 OIDC 클레임 필드"

#: models.py:88
msgid "First Name Claim"
msgstr "이름 클레임"

#: models.py:89
msgid "OIDC claim field for first name"
msgstr "OIDC 클레임 필드 - 이름"

#: models.py:94
msgid "Last Name Claim"
msgstr "성 클레임"

#: models.py:95
msgid "OIDC claim field for last name"
msgstr "OIDC 클레임 필드 - 성"

#: models.py:101
msgid "Groups Claim"
msgstr "그룹 클레임"

#: models.py:103
msgid ""
"OIDC claim field for group memberships (leave blank to disable group mapping)"
msgstr ""
"OIDC 클레임 필드 - 그룹 멤버십 (빈칸으로 남겨두면 그룹 매핑을 비활성화합니다)"

#: models.py:110
msgid "Staff Groups"
msgstr "직원 그룹"

#: models.py:111
msgid "Comma-separated group names or IDs that grant staff status"
msgstr "직원 권한을 부여하는 그룹 이름 또는 ID(콤마로 구분)"

#: models.py:115
msgid "Superuser Groups"
msgstr "슈퍼유저 그룹"

#: models.py:116
msgid "Comma-separated group names or IDs that grant superuser status"
msgstr "슈퍼유저 권한을 부여하는 그룹 이름 또는 ID(콤마로 구분)"

#: models.py:123
msgid "OIDC Scopes"
msgstr "OIDC 범위"

#: models.py:124
msgid "Space-separated OIDC scopes to request"
msgstr "요청할 OIDC 범위(공백으로 분리)"

#: models.py:130
msgid "Auto-Create Users"
msgstr "사용자 자동 생성"

#: models.py:132
msgid ""
"Automatically create a user account when an SSO user signs in for the first "
"time"
msgstr "SSO 사용자가 처음으로 로그인할 때 사용자 계정을 자동으로 생성합니다"

#: models.py:137
msgid "Restrict to Staff"
msgstr "직원 제한"

#: models.py:139
msgid ""
"Only allow existing staff users to sign in via SSO. Disable to allow SSO "
"user auto-creation."
msgstr ""
"기존 직원 사용자만 SSO를 통해 로그인하도록 허용합니다. 자동 생성을 허용하려"
"면 비활성화하세요."

