{% if product %}{% include 'email_marketing/blocks/_partials/section_open.mjml' %}{% if product.image %}<mj-image src="{{ product.image.fallback }}" alt="{{ product.name }}" href="{{ product.url }}" padding="0 24px 8px" />{% endif %}<mj-text align="center" font-size="18px" font-weight="bold" padding="0 24px">{{ product.name }}</mj-text><mj-text align="center" font-size="16px" padding="4px 24px 8px">{% if product.on_sale and product.was_price %}<span style="text-decoration:line-through;color:#999999;">{{ product.was_price }}</span>&nbsp;{% endif %}{{ product.price }}</mj-text><mj-button href="{{ product.url }}" border-radius="6px" padding="0 24px" inner-padding="12px 24px">{{ button_text|default:'Shop now' }}</mj-button>{% include 'email_marketing/blocks/_partials/section_close.mjml' %}{% endif %}
