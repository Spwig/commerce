{% include 'email_marketing/blocks/_partials/section_open.mjml' %}<mj-text align="{{ typo_align|default:'left' }}"{% if typo_color %} color="{{ typo_color }}"{% endif %}{% if typo_family %} font-family="{{ typo_family }}"{% endif %} font-size="{% if typo_size %}{{ typo_size }}{% elif level == 'h1' %}30px{% elif level == 'h3' %}20px{% else %}24px{% endif %}" font-weight="{{ typo_weight|default:'bold' }}"{% if typo_lh %} line-height="{{ typo_lh }}"{% endif %}{% if typo_ls %} letter-spacing="{{ typo_ls }}"{% endif %}{% if typo_style %} font-style="{{ typo_style }}"{% endif %}{% if typo_transform %} text-transform="{{ typo_transform }}"{% endif %} padding="0 24px">{{ text }}</mj-text>{% include 'email_marketing/blocks/_partials/section_close.mjml' %}
