{% include 'email_marketing/blocks/_partials/section_open.mjml' %}{% if image %}<mj-image src="{{ image }}" alt="{{ heading }}" padding="0 24px 8px" />{% endif %}{% if heading %}<mj-text align="center" font-size="20px" font-weight="bold" padding="0 24px 4px">{{ heading }}</mj-text>{% endif %}{% if subheading %}<mj-text align="center" font-size="14px" color="#555555" padding="0 24px 8px">{{ subheading|linebreaksbr }}</mj-text>{% endif %}{% if button_url %}<mj-button href="{{ button_url }}" border-radius="6px" padding="4px 24px 8px" inner-padding="12px 24px">{{ button_text|default:'Buy a gift card' }}</mj-button>{% endif %}{% include 'email_marketing/blocks/_partials/section_close.mjml' %}
