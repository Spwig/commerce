{% include 'email_marketing/blocks/_partials/section_open.mjml' %}<mj-text align="{{ typo_align|default:'left' }}"{% if typo_color %} color="{{ typo_color }}"{% endif %}{% if typo_family %} font-family="{{ typo_family }}"{% endif %} font-size="{{ typo_size|default:'14px' }}" font-weight="{{ typo_weight|default:'400' }}" line-height="{{ typo_lh|default:'1.6' }}"{% if typo_ls %} letter-spacing="{{ typo_ls }}"{% endif %}{% if typo_style %} font-style="{{ typo_style }}"{% endif %}{% if typo_transform %} text-transform="{{ typo_transform }}"{% endif %}{% if typo_decoration %} text-decoration="{{ typo_decoration }}"{% endif %} padding="0 24px">{{ text|linebreaksbr }}</mj-text>{% include 'email_marketing/blocks/_partials/section_close.mjml' %}
