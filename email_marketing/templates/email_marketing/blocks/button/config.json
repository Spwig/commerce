{
  "block_type": "button",
  "name": "Button",
  "icon": "fas fa-hand-pointer",
  "category": "content",
  "description": "A call-to-action button.",
  "properties": {
    "text": { "type": "string", "label": "Text", "default": "Shop now", "translatable": true },
    "href": { "type": "link", "label": "Link", "default": "#" },
    "align": {
      "type": "select",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    "bg_color": { "type": "color", "label": "Background", "default": "" },
    "text_color": { "type": "color", "label": "Text colour", "default": "" }
  },
  "defaults": {
    "text": "Shop now",
    "href": "#",
    "align": "center",
    "bg_color": "",
    "text_color": ""
  }
}
