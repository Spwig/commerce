{
  "block_type": "blog_posts",
  "name": "Blog Posts",
  "icon": "fas fa-newspaper",
  "category": "content",
  "description": "Feature your latest blog posts — ideal for a monthly newsletter.",
  "properties": {
    "heading": {
      "type": "string",
      "label": "Heading",
      "default": "From our blog",
      "translatable": true
    },
    "source": {
      "type": "select",
      "label": "Show",
      "default": "latest",
      "options": [
        { "value": "latest", "label": "Latest posts" },
        { "value": "since_last_send", "label": "New since last send" }
      ]
    },
    "count": {
      "type": "select",
      "label": "Posts",
      "default": "3",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    "layout": {
      "type": "select",
      "label": "Layout",
      "default": "list",
      "options": [
        { "value": "list", "label": "List (stacked)" },
        { "value": "grid", "label": "Grid (side by side)" }
      ]
    },
    "show_image": {
      "type": "select",
      "label": "Show image",
      "default": "yes",
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    "show_excerpt": {
      "type": "select",
      "label": "Show excerpt",
      "default": "yes",
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    "show_date": {
      "type": "select",
      "label": "Show date",
      "default": "yes",
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    "read_more_text": {
      "type": "string",
      "label": "Read more label",
      "default": "Read more",
      "translatable": true
    }
  },
  "defaults": {
    "heading": "From our blog",
    "source": "latest",
    "count": "3",
    "layout": "list",
    "show_image": "yes",
    "show_excerpt": "yes",
    "show_date": "yes",
    "read_more_text": "Read more"
  }
}
