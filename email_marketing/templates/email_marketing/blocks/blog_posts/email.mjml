{% if posts %}{% if layout == 'grid' %}<mj-section background-color="{{ section_bg|default:'#ffffff' }}" padding="{{ mj_padding|default:'16px 0' }}"{% if mj_border %} border="{{ mj_border }}"{% endif %}{% if mj_radius %} border-radius="{{ mj_radius }}"{% endif %}>{% if heading %}<mj-column width="100%"><mj-text align="center" font-size="20px" font-weight="bold" padding="0 24px 12px">{{ heading }}</mj-text></mj-column>{% endif %}{% for post in posts %}<mj-column>{% if show_image == 'yes' and post.image %}<mj-image src="{{ post.image.fallback }}" alt="{{ post.title }}" href="{{ post.url }}" padding="4px" />{% endif %}<mj-text font-size="15px" font-weight="bold" padding="4px">{{ post.title }}</mj-text>{% if show_date == 'yes' and post.date %}<mj-text font-size="12px" color="#888888" padding="0 4px 4px">{{ post.date }}</mj-text>{% endif %}{% if show_excerpt == 'yes' and post.excerpt %}<mj-text font-size="13px" color="#555555" padding="0 4px 6px">{{ post.excerpt }}</mj-text>{% endif %}<mj-text font-size="13px" padding="0 4px 4px"><a href="{{ post.url }}" style="color:#2563eb;text-decoration:none;">{{ read_more_text|default:'Read more' }} &rarr;</a></mj-text></mj-column>{% endfor %}</mj-section>{% else %}{% include 'email_marketing/blocks/_partials/section_open.mjml' %}{% if heading %}<mj-text font-size="20px" font-weight="bold" padding="0 24px 12px">{{ heading }}</mj-text>{% endif %}{% for post in posts %}{% if show_image == 'yes' and post.image %}<mj-image src="{{ post.image.fallback }}" alt="{{ post.title }}" href="{{ post.url }}" padding="8px 24px" />{% endif %}<mj-text font-size="16px" font-weight="bold" padding="0 24px">{{ post.title }}</mj-text>{% if show_date == 'yes' and post.date %}<mj-text font-size="12px" color="#888888" padding="0 24px 4px">{{ post.date }}</mj-text>{% endif %}{% if show_excerpt == 'yes' and post.excerpt %}<mj-text font-size="14px" color="#555555" padding="0 24px 6px">{{ post.excerpt }}</mj-text>{% endif %}<mj-text font-size="14px" padding="0 24px 16px"><a href="{{ post.url }}" style="color:#2563eb;text-decoration:none;">{{ read_more_text|default:'Read more' }} &rarr;</a></mj-text>{% endfor %}{% include 'email_marketing/blocks/_partials/section_close.mjml' %}{% endif %}{% endif %}
