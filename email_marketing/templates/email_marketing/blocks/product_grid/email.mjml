{% if products %}<mj-section background-color="{{ section_bg|default:'#ffffff' }}" padding="{{ mj_padding|default:'8px' }}"{% if mj_border %} border="{{ mj_border }}"{% endif %}{% if mj_radius %} border-radius="{{ mj_radius }}"{% endif %}>{% for p in products %}<mj-column>{% if p.image %}<mj-image src="{{ p.image.fallback }}" alt="{{ p.name }}" href="{{ p.url }}" padding="4px" />{% endif %}<mj-text align="center" font-size="14px" font-weight="bold" padding="4px 4px 0">{{ p.name }}</mj-text><mj-text align="center" font-size="13px" color="#555555" padding="0 4px 4px">{% if p.on_sale and p.was_price %}<span style="text-decoration:line-through;color:#999999;">{{ p.was_price }}</span>&nbsp;{% endif %}{{ p.price }}</mj-text></mj-column>{% endfor %}</mj-section>{% endif %}
