{% include 'email_marketing/blocks/_partials/section_open.mjml' %}{% if heading %}<mj-text align="center" font-size="18px" font-weight="bold" padding="0 24px 4px">{{ heading }}</mj-text>{% endif %}<mj-text align="center" padding="8px 24px"><span style="display:inline-block;border:2px dashed #999999;border-radius:8px;padding:12px 24px;font-size:22px;font-weight:bold;letter-spacing:2px;">{{ code }}</span></mj-text>{% if description %}<mj-text align="center" font-size="14px" color="#555555" padding="0 24px 8px">{{ description }}</mj-text>{% endif %}{% if button_url %}<mj-button href="{{ button_url }}" border-radius="6px" padding="4px 24px 8px" inner-padding="12px 24px">{{ button_text|default:'Shop now' }}</mj-button>{% endif %}{% include 'email_marketing/blocks/_partials/section_close.mjml' %}
