{% if has_items %}{% include 'email_marketing/blocks/_partials/section_open.mjml' %}{% if heading %}<mj-text align="center" font-size="20px" font-weight="bold" padding="0 24px 8px">{{ heading }}</mj-text>{% endif %}{% for item in items %}<mj-text padding="4px 24px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>{% if item.image %}<td width="72" valign="top"><a href="{{ item.url }}"><img src="{{ item.image.fallback }}" alt="{{ item.name }}" width="64" style="display:block;border-radius:4px;" /></a></td>{% endif %}<td valign="top" style="padding-left:12px;font-size:14px;color:#333333;"><a href="{{ item.url }}" style="color:#333333;text-decoration:none;font-weight:bold;">{{ item.name }}</a>{% if item.variant %}<br /><span style="color:#888888;font-size:12px;">{{ item.variant }}</span>{% endif %}<br /><span style="color:#555555;">{% if item.on_sale and item.was_price %}<span style="text-decoration:line-through;color:#999999;">{{ item.was_price }}</span>&nbsp;{% endif %}{{ item.price }}{% if item.quantity > 1 %} &times; {{ item.quantity }}{% endif %}</span></td></tr></table></mj-text>{% endfor %}<mj-button href="{{ cart_url }}" border-radius="6px" padding="12px 24px 8px" inner-padding="12px 24px">{{ button_text|default:'Return to cart' }}</mj-button>{% include 'email_marketing/blocks/_partials/section_close.mjml' %}{% endif %}
