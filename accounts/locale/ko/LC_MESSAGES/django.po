#: api_views.py:58
msgid "Register new user account"
msgstr "새 사용자 계정 등록"

#: api_views.py:60
msgid ""
"Create a new customer account with email and password. Returns user profile "
"and authentication token."
msgstr "이메일과 비밀번호를 사용하여 새 고객 계정을 생성합니다. 사용자 프로필과 인증 토큰을 반환합니다."

#: api_views.py:64
msgid "Registration successful, user created and logged in"
msgstr "등록 성공, 사용자가 생성되고 로그인되었습니다"

#: api_views.py:65
msgid "Invalid registration data or email already exists"
msgstr "잘못된 등록 데이터 또는 이메일이 이미 존재합니다"

#: api_views.py:94
msgid "Registration successful."
msgstr "등록 성공."

#: api_views.py:101
msgid "Registration failed."
msgstr "등록 실패."

#: api_views.py:108
msgid "User login"
msgstr "사용자 로그인"

#: api_views.py:110
msgid ""
"Authenticate user with email and password. Returns user profile and "
"authentication token for API access."
msgstr "이메일과 비밀번호로 사용자를 인증합니다. API 액세스를 위한 사용자 프로필과 인증 토큰을 반환합니다."

#: api_views.py:114
msgid "Login successful, returns user data and auth token"
msgstr "로그인 성공, 사용자 데이터 및 인증 토큰 반환"

#: api_views.py:115
msgid "Invalid credentials or account inactive"
msgstr "잘못된 자격 증명 또는 계정 비활성화"

#: api_views.py:144
msgid "Login successful."
msgstr "로그인 성공."

#: api_views.py:151
msgid "Login failed."
msgstr "로그인 실패."

#: api_views.py:158
msgid "User logout"
msgstr "사용자 로그아웃"

#: api_views.py:160
msgid ""
"Log out the current user and invalidate their authentication token. Requires"
" authentication."
msgstr "현재 사용자를 로그아웃하고 인증 토큰을 무효화합니다. 인증이 필요합니다."

#: api_views.py:165
msgid "Logout successful, token deleted"
msgstr "로그아웃 성공, 토큰 삭제됨"

#: api_views.py:188
msgid "Logout successful."
msgstr "로그아웃 성공."

#: api_views.py:194
msgid "Request password reset"
msgstr "비밀번호 재설정 요청"

#: api_views.py:196
msgid ""
"Request a password reset email. Sends reset link to email if account exists."
" Always returns success to prevent email enumeration. Rate limited to 20 "
"requests per hour."
msgstr ""
"비밀번호 재설정 이메일 요청. 계정이 존재할 경우 이메일로 재설정 링크를 전송합니다. 이메일 열거 방지를 위해 항상 성공을 반환합니다. "
"시간당 20회 요청으로 제한됩니다."

#: api_views.py:200
msgid "Password reset email sent (if account exists)"
msgstr "비밀번호 재설정 이메일이 발송되었습니다 (계정이 존재하는 경우)"

#: api_views.py:201
msgid "Invalid email format"
msgstr "잘못된 이메일 형식"

#: api_views.py:203
msgid "Rate limit exceeded - too many password reset requests"
msgstr "요청 한도 초과 - 너무 많은 비밀번호 재설정 요청"

#: api_views.py:253
msgid ""
"If an account with that email exists, a password reset link has been sent."
msgstr "그 이메일 주소로 계정이 존재하는 경우, 비밀번호 재설정 링크가 전송되었습니다."

#: api_views.py:260
msgid "Invalid email address."
msgstr "잘못된 이메일 주소입니다."

#: api_views.py:267
msgid "Confirm password reset"
msgstr "비밀번호 재설정 확인"

#: api_views.py:269
msgid ""
"Complete password reset process using the token from email. Requires uidb64 "
"and token from reset link."
msgstr "이메일에서 받은 토큰을 사용하여 비밀번호 재설정 프로세스를 완료합니다. 재설정 링크에서 uidb64 및 토큰이 필요합니다."

#: api_views.py:273
msgid "Password successfully reset"
msgstr "비밀번호가 성공적으로 재설정되었습니다."

#: api_views.py:274
msgid "Invalid or expired reset token, or invalid password"
msgstr "잘못된 또는 만료된 재설정 토큰, 또는 잘못된 비밀번호"

#: api_views.py:293
msgid "Invalid password reset link."
msgstr "잘못된 비밀번호 재설정 링크입니다."

#: api_views.py:305
msgid "Password has been reset successfully."
msgstr "비밀번호가 성공적으로 재설정되었습니다."

#: api_views.py:310
msgid "Password reset failed."
msgstr "비밀번호 재설정 실패."

#: api_views.py:317
msgid "Get user profile"
msgstr "사용자 프로필 가져오기"

#: api_views.py:319
msgid ""
"Retrieve the current authenticated user's profile information including "
"name, preferences, and settings."
msgstr "인증된 현재 사용자의 프로필 정보(이름, 선호도 및 설정)를 검색합니다."

#: api_views.py:339
msgid "Update user profile"
msgstr "사용자 프로필 업데이트"

#: api_views.py:341
msgid ""
"Update the current user's profile information. Use PUT for full update or "
"PATCH for partial update."
msgstr "현재 사용자의 프로필 정보를 업데이트합니다. 전체 업데이트에는 PUT, 부분 업데이트에는 PATCH를 사용하십시오."

#: api_views.py:345
msgid "Profile updated successfully"
msgstr "프로필이 성공적으로 업데이트되었습니다."

#: api_views.py:346
msgid "Invalid profile data"
msgstr "잘못된 프로필 데이터"

#: api_views.py:371 views.py:682
msgid "Profile updated successfully."
msgstr "프로필이 성공적으로 업데이트되었습니다."

#: api_views.py:378
msgid "Profile update failed."
msgstr "프로필 업데이트 실패."

#: api_views.py:385
msgid "Update user preferences"
msgstr "사용자 선호사항 업데이트"

#: api_views.py:387
msgid ""
"Update user dashboard preferences including notification settings, display "
"options, and other customization."
msgstr "알림 설정, 표시 옵션 및 기타 커스터마이징을 포함한 사용자 대시보드 선호도를 업데이트합니다."

#: api_views.py:392
msgid "Invalid preference data"
msgstr "잘못된 선호도 데이터"

#: api_views.py:414 api_views.py:956
msgid "Preferences updated successfully."
msgstr "환경 설정이 성공적으로 업데이트되었습니다."

#: api_views.py:421
msgid "Preferences update failed."
msgstr "환경 설정 업데이트 실패."

#: api_views.py:428
msgid "Refresh customer metrics"
msgstr "고객 메트릭스 새로 고침"

#: api_views.py:430
msgid ""
"Recalculate and update customer metrics including order count, total spent, "
"lifetime value, etc."
