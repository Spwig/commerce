#: validators.py:36
#, python-format
msgid "%(field)s is required."
msgstr "%(field)s est obligatoire."

#: validators.py:59
#, python-format
msgid "%(field)s must be at least %(min)d characters."
msgstr "%(field)s doit avoir au moins %(min)d caractères."

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s ne peut pas dépasser %(max)d caractères."

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s ne correspond pas au motif requis."

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s doit être un nombre entier."

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s doit être au moins %(min)s."

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s ne peut pas dépasser %(max)s."

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s doit être un nombre décimal valide."

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s doit être une date valide (YYYY-MM-DD)."

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s doit être une date et une heure valides."

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s doit être une URL valide."

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s doit être une adresse e-mail valide."

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" n'est pas un choix valide."

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s doit être une liste de valeurs."

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr "%(field)s doit être une couleur hexadécimale valide (ex. #FF0000)."

