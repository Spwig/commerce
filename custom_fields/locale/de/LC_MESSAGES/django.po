#: validators.py:36
#, python-format
msgid "%(field)s is required."
msgstr "%(field)s ist erforderlich."

#: validators.py:59
#, python-format
msgid "%(field)s must be at least %(min)d characters."
msgstr "%(field)s muss mindestens %(min)d Zeichen lang sein."

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s darf maximal %(max)d Zeichen haben."

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s stimmt nicht mit dem erforderten Muster überein."

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s muss eine ganze Zahl sein."

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s muss mindestens %(min)s sein."

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s darf maximal %(max)s sein."

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s muss eine gültige Dezimalzahl sein."

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s muss ein gültiges Datum (YYYY-MM-DD) sein."

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s muss ein gültiges Datum und eine Uhrzeit sein."

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s muss eine gültige URL sein."

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s muss eine gültige E-Mail-Adresse sein."

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" ist keine gültige Option."

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s muss eine Liste von Werten sein."

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr "%(field)s muss eine gültige Hex-Farbe sein (z. B. #FF0000)."

