msgstr "%(field)s 至少需要 %(min)d 個字元。"

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s 最多只能有 %(max)d 個字元。"

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s 不符合所需的格式。"

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s 必須為整數。"

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s 至少需要 %(min)s。"

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s 最多只能有 %(max)s。"

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s 必須為有效的十進位數字。"

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s 必須為有效的日期 (YYYY-MM-DD)。"

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s 必須為有效的日期和時間。"

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s 必須為有效的 URL。"

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s 必須為有效的電子郵件地址。"

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" 不是有效的選擇。"

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s 必須為值的清單。"

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr "%(field)s 必須為有效的十六進位顏色 (例如，#FF0000)。"

