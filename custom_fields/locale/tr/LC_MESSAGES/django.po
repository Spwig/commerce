#: validators.py:36
#, python-format
msgid "%(field)s is required."
msgstr "%(field)s zorunludur."

#: validators.py:59
#, python-format
msgid "%(field)s must be at least %(min)d characters."
msgstr "%(field)s en az %(min)d karakter olmalıdır."

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s en fazla %(max)d karakter olmalıdır."

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s gerekli desene uymuyor."

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s bir tam sayı olmalıdır."

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s en az %(min)s olmalıdır."

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s en fazla %(max)s olmalıdır."

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s geçerli bir ondalık sayı olmalıdır."

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s geçerli bir tarih (YYYY-MM-DD) olmalıdır."

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s geçerli bir tarih ve saat olmalıdır."

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s geçerli bir URL olmalıdır."

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s geçerli bir e-posta adresi olmalıdır."

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" geçerli bir seçenek değildir."

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s değerlerin bir listesi olmalıdır."

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr "%(field)s geçerli bir heksadesimal renk olmalıdır (örneğin, #FF0000)."

