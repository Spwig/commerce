#: validators.py:36
#, python-format
msgid "%(field)s is required."
msgstr "%(field)s è obbligatorio."

#: validators.py:59
#, python-format
msgid "%(field)s must be at least %(min)d characters."
msgstr "%(field)s deve essere almeno %(min)d caratteri."

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s deve essere al massimo %(max)d caratteri."

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s non corrisponde al modello richiesto."

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s deve essere un numero intero."

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s deve essere almeno %(min)s."

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s deve essere al massimo %(max)s."

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s deve essere un numero decimale valido."

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s deve essere una data valida (YYYY-MM-DD)."

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s deve essere una data e un'ora valide."

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s deve essere un URL valido."

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s deve essere un indirizzo email valido."

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" non è una scelta valida."

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s deve essere un elenco di valori."

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr "%(field)s deve essere un colore esadecimale valido (es. #FF0000)."

