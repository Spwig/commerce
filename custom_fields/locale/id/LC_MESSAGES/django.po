#: validators.py:36
#, python-format
msgid "%(field)s is required."
msgstr "%(field)s diperlukan."

#: validators.py:59
#, python-format
msgid "%(field)s must be at least %(min)d characters."
msgstr "%(field)s harus memiliki setidaknya %(min)d karakter."

#: validators.py:64
#, python-format
msgid "%(field)s must be at most %(max)d characters."
msgstr "%(field)s harus memiliki maksimal %(max)d karakter."

#: validators.py:69
#, python-format
msgid "%(field)s does not match the required pattern."
msgstr "%(field)s tidak cocok dengan pola yang diperlukan."

#: validators.py:81
#, python-format
msgid "%(field)s must be a whole number."
msgstr "%(field)s harus berupa bilangan bulat."

#: validators.py:88 validators.py:113
#, python-format
msgid "%(field)s must be at least %(min)s."
msgstr "%(field)s harus setidaknya %(min)s."

#: validators.py:93 validators.py:118
#, python-format
msgid "%(field)s must be at most %(max)s."
msgstr "%(field)s harus paling banyak %(max)s."

#: validators.py:105
#, python-format
msgid "%(field)s must be a valid decimal number."
msgstr "%(field)s harus berupa angka desimal yang valid."

#: validators.py:143
#, python-format
msgid "%(field)s must be a valid date (YYYY-MM-DD)."
msgstr "%(field)s harus berupa tanggal yang valid (YYYY-MM-DD)."

#: validators.py:158
#, python-format
msgid "%(field)s must be a valid date and time."
msgstr "%(field)s harus berupa tanggal dan waktu yang valid."

#: validators.py:169
#, python-format
msgid "%(field)s must be a valid URL."
msgstr "%(field)s harus berupa URL yang valid."

#: validators.py:180
#, python-format
msgid "%(field)s must be a valid email address."
msgstr "%(field)s harus berupa alamat email yang valid."

#: validators.py:191 validators.py:210
#, python-format
msgid "%(field)s: \"%(value)s\" is not a valid choice."
msgstr "%(field)s: \"%(value)s\" bukan pilihan yang valid."

#: validators.py:203
#, python-format
msgid "%(field)s must be a list of values."
msgstr "%(field)s harus berupa daftar nilai."

#: validators.py:221
#, python-format
msgid "%(field)s must be a valid hex color (e.g., #FF0000)."
msgstr ""
"%(field)s harus berupa warna heksadesimal yang valid (contoh: #FF0000)."

