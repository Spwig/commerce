#: admin.py:2807
msgid "Invalid request data"
msgstr "Недопустимые данные запроса"

#: admin.py:2812
msgid "An unexpected error occurred. Please try again."
msgstr "Случилась неожиданная ошибка. Пожалуйста, попробуйте еще раз."

#: admin.py:2848
#, python-format
msgid "%d review(s) approved."
msgstr "%d отзыв(ов) одобрен(ы)."

#: admin.py:2850
