msgstr "Не для перепродажи"

#: models.py:1085 models.py:4372
msgid "Educational"
msgstr "Образовательная"

#: models.py:1086 models.py:4373
msgid "Standard"
msgstr "Стандартная"

#: models.py:1089
msgid "Default License Type"
msgstr "Тип лицензии по умолчанию"

#: models.py:1090
msgid "Default license type for this product when licenses are generated."
msgstr "Тип лицензии по умолчанию для этого товара при генерации лицензий."

#: models.py:1095
msgid "Default Max Activations"
msgstr "Максимальное количество активаций по умолчанию"

#: models.py:1096
msgid ""
"Default maximum device activations per license. Leave blank for unlimited."
msgstr ""
"Максимальное количество активаций устройств на одну лицензию по умолчанию. "
"Оставьте пустым для неограниченного количества."

#: models.py:1101
msgid "Default Validity (Days)"
msgstr "Срок действия по умолчанию (дни)"

#: models.py:1103
msgid ""
"Default license validity in days from issue date. Leave blank for never "
"expires."
msgstr ""
"Срок действия лицензии в днях с даты выдачи. Оставьте пустым, чтобы лицензия"
" никогда не истекала."

#: models.py:1112 models.py:5079
msgid "License Provider"
msgstr "Поставщик лицензии"

#: models.py:1113
msgid "External provider to sync licenses to when orders are placed."
msgstr "Внешний поставщик для синхронизации лицензий при оформлении заказов."

#: models.py:1118
msgid "External Product ID"
msgstr "Внешний идентификатор товара"

#: models.py:1119
msgid "Product/Policy ID in the external license provider system."
msgstr "Идентификатор товара/политики в системе внешнего поставщика лицензий."

#: models.py:1123
msgid "Generate License Key"
msgstr "Создать лицензионный ключ"

#: models.py:1125
msgid ""
"Generate a license key when this product is purchased. Enable for software "
"licenses, API keys, or activation codes."
msgstr ""
"Генерировать ключ лицензии при покупке этого товара. Включите для лицензий "
"на программное обеспечение, ключей API или кодов активации."

#: models.py:1130
msgid "When payment is confirmed"
msgstr "После подтверждения оплаты"

#: models.py:1131
msgid "When order is created"
msgstr "После создания заказа"

#: models.py:1132
msgid "Manual only (admin generates)"
msgstr "Только вручную (админ генерирует)"

#: models.py:1138
msgid "Generate License"
msgstr "Создать лицензию"

#: models.py:1139
msgid "When to automatically generate the license key for this product."
msgstr "Когда автоматически генерировать ключ лицензии для этого товара."

#: models.py:1152
msgid "All Channels"
msgstr "Все каналы"

#: models.py:1153
msgid "Online Only"
msgstr "Только онлайн"

#: models.py:1154
msgid "In-Store Only"
msgstr "Только в магазине"

#: models.py:1157
msgid "sales channel"
msgstr "канал продаж"

#: models.py:1162
msgid "Where this product can be sold"
msgstr "Где можно продавать этот товар"

#: models.py:1165 models.py:2774
msgid "barcode"
msgstr "штрих-код"

#: models.py:1169
msgid "EAN/UPC barcode for POS scanning"
msgstr "Штрих-код EAN/UPC для сканирования в POS"

#: models.py:1177
msgid "Tags"
msgstr "Теги"

#: models.py:1178
msgid "Tags for product organization and filtering"
msgstr "Теги для организации и фильтрации товаров"

#: models.py:1183
msgid "Whether this product has been soft deleted"
msgstr "Был ли этот товар мягко удален"

#: models.py:1186
msgid "When this product was soft deleted"
msgstr "Когда этот товар был мягко удален"

#: models.py:1194
msgid "User who deleted this product"
msgstr "Пользователь, удаливший этот товар"

#: models.py:1996
msgid "Price must be greater than zero."
msgstr "Цена должна быть больше нуля."

#: models.py:2001
msgid "HS code must be 6-12 digits. Example: 620342 or 62034235"
msgstr "Код HS должен состоять из 6-12 цифр. Пример: 620342 или 62034235"

#: models.py:2011
msgid "Country code must be 2-letter ISO code. Example: US, CA, DE"
msgstr "Код страны должен быть 2-буквенным кодом ISO. Пример: US, CA, DE"

#: models.py:2023
msgid "Customs unit price is required when HS code is specified"
msgstr "Таможенная цена за единицу обязательна, если указан код HS"

#: models.py:2031
msgid "Export license expiry date must be in the future"
msgstr "Дата окончания действия лицензии на экспорт должна быть в будущем"

#: models.py:2051
msgid ""
