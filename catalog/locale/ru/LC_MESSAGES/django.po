msgid "Perpetual"
msgstr "Бессрочная"

#: models.py:1082 models.py:4369
#: templates/admin/catalog/licensekey/change_list.html:80
#: templates/admin/catalog/product/change_list.html:178
#: templates/admin/catalog/product/change_list.html:181
msgid "Subscription"
msgstr "Подписка"

#: models.py:1083 models.py:4370
#: templates/admin/catalog/licensekey/change_list.html:79
msgid "Trial"
msgstr "Тестовая"

#: models.py:1084 models.py:4371
