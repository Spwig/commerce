msgstr "Tanggal Tertutup"

#: templates/admin/catalog/product/change_form.html:1882
msgid ""
"Block specific dates or date ranges when bookings are not accepted "
"(holidays, maintenance, closures)."
msgstr ""
"Blok tanggal atau rentang tanggal tertentu saat pemesanan tidak diterima "
"(liburan, perawatan, penutupan)."

#: templates/admin/catalog/product/change_form.html:1887
msgid "Loading blackout periods..."
