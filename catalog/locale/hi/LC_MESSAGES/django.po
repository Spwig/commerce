msgstr "पुनर्विक्रय के लिए नहीं"

#: models.py:1085 models.py:4372
msgid "Educational"
msgstr "शैक्षिक"

#: models.py:1086 models.py:4373
msgid "Standard"
msgstr "मानक"

#: models.py:1089
msgid "Default License Type"
msgstr "डिफ़ॉल्ट लाइसेंस प्रकार"

