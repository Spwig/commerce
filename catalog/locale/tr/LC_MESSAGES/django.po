msgstr ""
"Kimliği doğrulanmış müşterinin sahip olduğu belirli bir rezervasyon hakkında"
" detaylı bilgi döndürür."

#: api/booking_endpoints.py:1070
msgid "Cancel my booking"
msgstr "Rezervasyonumu iptal et"

#: api/booking_endpoints.py:1071
msgid "Cancel a booking. Only pending or confirmed bookings can be cancelled."
msgstr ""
"Bir rezervasyonu iptal et. Sadece bekleyen veya onaylanmış rezervasyonlar "
"iptal edilebilir."

#: api/booking_endpoints.py:1111
msgid "Reschedule my booking"
msgstr "Rezervasyonumu yeniden planla"

#: api/booking_endpoints.py:1112
msgid ""
"\n"
"    Reschedule a booking to a new date and time. Checks availability before\n"
"    confirming the change. Only pending or confirmed bookings can be rescheduled.\n"
"    "
msgstr ""
"\n"
"    Bir rezervasyonu yeni bir tarih ve saate yeniden planla. Değişikliğin onaylanmasından önce mevcutluğu kontrol eder. Sadece bekleyen veya onaylanan rezervasyonlar yeniden planlanabilir.\n"
"    "

