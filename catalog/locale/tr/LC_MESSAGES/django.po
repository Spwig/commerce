msgid "No Design Editor"
msgstr "Tasarım Editörü Yok"

#: templates/admin/catalog/product/change_form.html:1511
msgid ""
"Open the Design Editor Setup to configure surfaces and enable the visual "
"customization experience."
msgstr ""
"Yüzeyleri yapılandırmak ve görsel özelleştirme deneyimini etkinleştirmek "
"için Tasarım Düzenleyici Kurulumunu açın."

