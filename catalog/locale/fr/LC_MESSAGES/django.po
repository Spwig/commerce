msgid "3D Scene Configured"
msgstr "Scène 3D configurée"

#: templates/admin/catalog/product/change_form.html:1767
msgid "This product has a 3D scene. Open the Scene Manager to edit it."
msgstr ""
"Ce produit a une scène 3D. Ouvrez le gestionnaire de scènes pour l'éditer."

