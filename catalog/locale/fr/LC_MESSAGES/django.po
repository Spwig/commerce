#: templates/admin/catalog/product/change_form.html:635
msgid ""
"Simplified stock management mode. Enter the total stock quantity below. To "
"enable multi-warehouse inventory tracking, go to Store Settings > Inventory."
msgstr ""
"Mode de gestion simplifiée des stocks. Entrez la quantité totale de stock "
"ci-dessous. Pour activer la gestion des stocks multi-entrepôt, allez dans "
"Paramètres du magasin > Inventaire."

#: templates/admin/catalog/product/change_form.html:659
msgid "Stock Quantity"
msgstr "Quantité en stock"

#: templates/admin/catalog/product/change_form.html:667
