msgid "Low Stock Alert"
msgstr "Thông báo hàng tồn thấp"

#: templates/admin/catalog/edit_inline/variant_stacked.html:409
msgid ""
"Set a threshold to receive notifications when available stock falls below "
"this level. Leave at 0 to disable low stock alerts"
msgstr ""
"Thiết lập ngưỡng để nhận thông báo khi tồn kho có sẵn giảm xuống dưới mức "
"này. Để ở 0 để tắt cảnh báo tồn kho thấp"

#: templates/admin/catalog/edit_inline/variant_stacked.html:447
msgid "No stock records for this variant yet"
msgstr "Chưa có bản ghi tồn kho cho biến thể này"

#: templates/admin/catalog/edit_inline/variant_stacked.html:448
msgid "Stock will be created when you add inventory to warehouses"
msgstr "Tồn kho sẽ được tạo khi bạn thêm tồn kho vào kho"

