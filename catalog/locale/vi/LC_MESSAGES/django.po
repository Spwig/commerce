msgstr ""
"Xác định các tùy chọn nào tương thích với các vị trí. Sử dụng ma trận tương "
"thích để quản lý các quy tắc một cách trực quan."

#: templates/admin/catalog/product/change_form.html:1662
msgid "rules defined"
msgstr "quy tắc đã xác định"

#: templates/admin/catalog/product/change_form.html:1666
