#: views.py:882
msgid "You must be logged in to register as an affiliate."
msgstr "Affiliat olarak kayıt olmak için oturum açmanız gerekir."

#: views.py:894
msgid "Email is required."
msgstr "E-posta gerekli."

#: views.py:898
msgid "Password is required."
msgstr "Şifre gerekli."

#: views.py:906
msgid "An account with this email already exists. Please log in instead."
msgstr "Bu e-posta adresiyle bir hesap zaten mevcut. Lütfen oturum açın."

#: views.py:927
msgid "Failed to create user account. Please try again."
msgstr "Kullanıcı hesabı oluşturulamadı. Lütfen tekrar deneyin."

#: views.py:934
msgid "You already have an affiliate account."
msgstr "Zaten bir affiliate hesabı vardır."

#: views.py:944
msgid "You must accept the terms and conditions to register."
msgstr "Kayıt olmak için koşulları ve şartları kabul etmeniz gerekir."

#: views.py:981
msgid "Thank you for registering! Your application is being reviewed."
msgstr "Kayıt olmanız için teşekkür ederiz! Başvurunuz inceleniyor."

#: views.py:1020
msgid "You must be an affiliate to create links."
msgstr "Bağlantı oluşturmak için bir affilatör olmanız gerekir."

#: views.py:1030
msgid "You are not approved for this program."
msgstr "Bu programa onaylı değilsiniz."

#: views.py:1173 views.py:1660
msgid "Program activated successfully."
msgstr "Program başarıyla etkinleştirildi."

#: views.py:1178
msgid "Program cannot be activated from its current status."
msgstr "Program mevcut durumundan etkinleştirilemez."

#: views.py:1186 views.py:1661
msgid "Program paused successfully."
msgstr "Program başarıyla durduruldu."

#: views.py:1189
msgid "Only active programs can be paused."
msgstr "Yalnızca aktif programlar durdurulabilir."

#: views.py:1193 views.py:1440 views.py:1559
msgid "Invalid action."
msgstr "Geçersiz işlem."

#: views.py:1197 views.py:1669
msgid "Program not found."
msgstr "Program bulunamadı."

#: views.py:1233
msgid "Program name must be 200 characters or fewer."
msgstr "Program adı 200 karakter veya daha az olmalıdır."

#: views.py:1251
msgid "Commission value is required."
msgstr "Komisyon değeri gerekli."

#: views.py:1256
msgid "Commission value must be positive."
msgstr "Komisyon değeri pozitif olmalıdır."

#: views.py:1258
msgid "Percentage cannot exceed 100%."
msgstr "Yüzde 100%'yi geçemez."

#: views.py:1260
msgid "Invalid commission value."
msgstr "Geçersiz komisyon değeri."

#: views.py:1266
msgid "Cookie lifetime must be between 1 and 365 days."
msgstr "Çerez ömrü 1 ile 365 gün arasında olmalıdır."

#: views.py:1269
msgid "Invalid cookie lifetime."
msgstr "Geçersiz çerez ömrü."

#: views.py:1274
msgid "Minimum payout must be positive."
msgstr "Minimum ödeme pozitif olmalıdır."

#: views.py:1276
msgid "Invalid minimum payout."
msgstr "Geçersiz minimum ödeme."

#: views.py:1299
msgid "Affiliate program created successfully."
msgstr "Affiliate programı başarıyla oluşturuldu."

#: views.py:1315
msgid "Program is live and accepting affiliates"
msgstr "Program canlıdır ve affiliate'leri kabul ediyor"

#: views.py:1316
msgid "Program is temporarily paused"
msgstr "Program geçici olarak durduruldu"

#: views.py:1410
msgid "Affiliate approved successfully."
msgstr "Affiliate başarıyla onaylandı."

#: views.py:1413
msgid "Only pending affiliates can be approved."
msgstr "Yalnızca bekleyen affiliate'ler onaylanabilir."

#: views.py:1420
msgid "Affiliate suspended successfully."
msgstr "Affiliate başarıyla askıya alındı."

#: views.py:1423
msgid "Only active affiliates can be suspended."
msgstr "Yalnızca aktif affiliate'ler askıya alınabilir."

#: views.py:1430
msgid "Affiliate activated successfully."
msgstr "Affiliate başarıyla etkinleştirildi."

#: views.py:1435
msgid "Affiliate cannot be activated from current status."
msgstr "Affiliate mevcut durumundan etkinleştirilemez."

#: views.py:1444
msgid "Affiliate not found."
msgstr "Affiliate bulunamadı."

#: views.py:1542
msgid "Membership approved successfully."
msgstr "Üyelik başarıyla onaylandı."

#: views.py:1545
msgid "Only pending memberships can be approved."
msgstr "Yalnızca bekleyen üyelikler onaylanabilir."

#: views.py:1552
msgid "Membership rejected successfully."
msgstr "Üyelik başarıyla reddedildi."

#: views.py:1555
msgid "Only pending memberships can be rejected."
msgstr "Yalnızca bekleyen üyelikler reddedilebilir."

#: views.py:1563
msgid "Membership not found."
msgstr "Üyelik bulunamadı."

#: views.py:1652
msgid "Invalid status."
msgstr "Geçersiz durum."

#: views.py:1662
msgid "Program archived successfully."
msgstr "Program başarıyla arşivlendi."

