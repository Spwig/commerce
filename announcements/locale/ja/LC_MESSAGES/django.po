msgstr "公開中のID"

#: api_views.py:118
msgid "Announcement detail"
msgstr "公開中の情報"

#: api_views.py:119
msgid "Not found, inactive, or expired"
msgstr "見つかりません、非アクティブ、または有効期限切れ"

