msgstr "Отобразить имя и аватар автора поста."

#: template_registry.py:1199 template_registry.py:1225
#: template_registry.py:1258 template_registry.py:1278
msgid "Show share buttons"
msgstr "Показать кнопки для совместного использования"

#: template_registry.py:1200 template_registry.py:1226
#: template_registry.py:1259 template_registry.py:1279
msgid "Display social sharing buttons after the article."
msgstr "Отобразить кнопки социального разделения после статьи."

#: template_registry.py:1205 template_registry.py:1231
#: template_registry.py:1264 template_registry.py:1284
msgid "Show related posts"
msgstr "Показать связанные публикации"

#: template_registry.py:1206 template_registry.py:1232
#: template_registry.py:1265 template_registry.py:1285
msgid "Display related articles after the post content."
msgstr "Отображать связанные статьи после содержимого поста."

#: template_registry.py:1211 template_registry.py:1290
msgid "Show subscribe CTA"
msgstr "Показать призыв к подписке"

#: template_registry.py:1212 template_registry.py:1291
msgid "Display a subscribe call-to-action after the article."
msgstr "Отображать призыв к подписке после статьи."

#: template_registry.py:1220 template_registry.py:1315
#: template_registry.py:1347
msgid "Display the post author name."
msgstr "Отобразить имя автора публикации."

#: template_registry.py:1237
msgid "Content width"
msgstr "Ширина содержимого"

#: template_registry.py:1238
msgid "Maximum width of the article content."
msgstr "Максимальная ширина содержимого статьи."

#: template_registry.py:1252
msgid "Show author bio"
msgstr "Показывать биографию автора"

#: template_registry.py:1253
msgid "Display full author biography section below the article."
msgstr "Отображать полный биографический раздел автора под статьей."

#: template_registry.py:1301
msgid "Grid columns"
msgstr "Количество колонок решетки"

#: template_registry.py:1302
msgid "Number of columns in the blog post grid."
msgstr "Количество колонок в сетке блога."

#: template_registry.py:1308 template_registry.py:1334
#: template_registry.py:1367
msgid "Show excerpt"
msgstr "Показывать выдержку"

#: template_registry.py:1309 template_registry.py:1368
msgid "Display post excerpt below the title."
msgstr "Отображать выдержку поста под заголовком."

#: template_registry.py:1320 template_registry.py:1381
msgid "Show date"
msgstr "Показывать дату"

#: template_registry.py:1321 template_registry.py:1382
msgid "Display the published date."
msgstr "Отображать дату публикации."

#: template_registry.py:1326 template_registry.py:1373
#: template_registry.py:1387
msgid "Show category"
msgstr "Показать категорию"

#: template_registry.py:1327 template_registry.py:1374
msgid "Display the post category badge."
msgstr "Показывать значок категории поста."

#: template_registry.py:1335
msgid "Display post excerpt in each row."
msgstr "Отображать выдержку поста в каждой строке."

#: template_registry.py:1340
msgid "Show image"
msgstr "Показать изображение"

#: template_registry.py:1341
msgid "Display featured image thumbnail."
msgstr "Показывать миниатюру основного изображения."

#: template_registry.py:1352 template_registry.py:1393
msgid "Show reading time"
msgstr "Показать время чтения"

#: template_registry.py:1353 template_registry.py:1394
msgid "Display estimated reading time."
msgstr "Показывать оценочное время чтения."

#: template_registry.py:1360
msgid "Featured posts"
msgstr "Выделенные посты"

#: template_registry.py:1361
msgid "Number of featured/hero posts at the top."
msgstr "Количество выделенных/главных постов вверху."

#: template_registry.py:1388
msgid "Display the post category."
msgstr "Отобразить категорию поста."

