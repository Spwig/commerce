#: admin.py:1483
msgid "This migration cannot be rolled back."
msgstr "Bu geçiş geri alınamaz."

#: admin.py:1498
msgid "This rollback is already running."
msgstr "Bu geri alma işlemi zaten çalışıyor."

#: admin.py:1517
msgid "Spwig could not start the rollback. Nothing has been removed."
msgstr "Spwig geri alma işlemini başlatamadı. Hiçbir şey kaldırılmadı."

#: admin.py:1524
msgid ""
"Rollback started. This runs in the background — check back shortly to see "
"what was removed and what was kept."
msgstr ""
"Geri alma işlemi başladı. Bu arka planda çalışır — kısa süre sonra ne "
"kaldırıldığını ve ne kaldığını görmek için tekrar kontrol edin."

#: admin.py:1543
msgid ""
"Spwig could not calculate this in advance. The rollback itself will still "
"report what it removed and what it kept."
msgstr ""
"Spwig bunu önceden hesaplayamadı. Geri alma işlemi kendisi hala ne "
"kaldırıldığını ve ne kaldığını bildirecektir."

#: admin.py:1551 templates/admin/migration/confirm_rollback.html:4
#: templates/admin/migration/confirm_rollback.html:13
msgid "Confirm Rollback"
msgstr "Geri Alma'yı Onayla"

#: admin.py:1575
msgid "Only failed migrations can be retried."
msgstr "Yalnızca başarısız olan geçişler yeniden denenebilir."

#: admin.py:1600
msgid ""
"Migration restarted. It runs from the beginning and skips items that have "
"already been imported."
msgstr ""
"Göç yeniden başlatıldı. Göç, baştan başlar ve zaten aktarılmış olan öğeleri "
"atlar."

#: admin.py:1608
msgid "Failed to restart migration: {}"
msgstr "Göçün yeniden başlatılması başarısız oldu: {}"

