msgid ""
"Migration started. You can safely close this window and check back later."
msgstr ""
"Migrasi telah dimulai. Anda dapat aman menutup jendela ini dan memeriksa "
"kembali nanti."

#: admin.py:1245
msgid "Failed to start import: {}"
msgstr "Gagal memulai impor: {}"

#: admin.py:1259
msgid "This migration has already been started."
msgstr "Migrasi ini sudah dimulai."

#: admin.py:1278
msgid "Migration Wizard - Importing"
