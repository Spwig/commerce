msgstr "Transporteur manuel par défaut"

#: models.py:615
msgid "Shipping Origin Country"
msgstr "Pays d'origine de la livraison"

#: models.py:666
msgid "Default Weight Unit"
msgstr "Unité de poids par défaut"

#: models.py:674
msgid "Default Length Unit"
msgstr "Unité de longueur par défaut"

#: models.py:682
msgid "Default Volume Unit"
msgstr "Unité de volume par défaut"

#: models.py:690
msgid "Default Area Unit"
msgstr "Unité d'aire par défaut"

#: models.py:698
msgid "Default Temperature Unit"
msgstr "Unité de température par défaut"

#: models.py:704
msgid "Enable Unit Conversion for Customers"
msgstr "Activer la conversion d'unités pour les clients"

#: models.py:749
msgid "Optional - Staff can choose to enable 2FA"
msgstr "Facultatif - Le personnel peut choisir d'activer le 2FA"

#: models.py:750
msgid "Recommended - Prompt staff to enable 2FA"
msgstr "Recommandé - Inciter le personnel à activer le 2FA"

#: models.py:751
msgid "Required - Staff must enable 2FA to access admin"
msgstr "Obligatoire - Le personnel doit activer le 2FA pour accéder à l'admin"

#: models.py:758
msgid "Staff 2FA Enforcement"
msgstr "Application obligatoire du 2FA pour le personnel"

#: models.py:759
msgid "Control whether two-factor authentication is required for admin access"
msgstr ""
"Contrôler si l'authentification à deux facteurs est requise pour l'accès "
"administrateur"

#: models.py:764
msgid "2FA Setup Grace Period (Days)"
msgstr "Période de grâce pour la configuration du 2FA (en jours)"

