msgstr "Negara Asal Pengiriman"

#: models.py:666
msgid "Default Weight Unit"
msgstr "Satuan Berat Default"

#: models.py:674
msgid "Default Length Unit"
msgstr "Satuan Panjang Default"

#: models.py:682
msgid "Default Volume Unit"
msgstr "Satuan Volume Default"

#: models.py:690
msgid "Default Area Unit"
msgstr "Satuan Luas Default"

#: models.py:698
msgid "Default Temperature Unit"
msgstr "Satuan Suhu Default"

#: models.py:704
msgid "Enable Unit Conversion for Customers"
msgstr "Aktifkan Konversi Satuan untuk Pelanggan"

#: models.py:749
msgid "Optional - Staff can choose to enable 2FA"
msgstr "Opsional - Staf dapat memilih untuk mengaktifkan 2FA"

#: models.py:750
msgid "Recommended - Prompt staff to enable 2FA"
msgstr "Dianjurkan - Dorong staf untuk mengaktifkan 2FA"

#: models.py:751
msgid "Required - Staff must enable 2FA to access admin"
msgstr "Wajib - Staf harus mengaktifkan 2FA untuk mengakses admin"

#: models.py:758
msgid "Staff 2FA Enforcement"
msgstr "Paksa 2FA untuk Staf"

#: models.py:759
msgid "Control whether two-factor authentication is required for admin access"
msgstr "Kontrol apakah autentikasi dua faktor diperlukan untuk akses admin"

#: models.py:764
msgid "2FA Setup Grace Period (Days)"
msgstr "Periode Grasi Pengaturan 2FA (Hari)"

#: models.py:766 templates/admin/core/sitesettings/change_form.html:1243
msgid ""
"Days allowed for staff to set up 2FA after enforcement is enabled. Set to 0 "
"for immediate enforcement."
