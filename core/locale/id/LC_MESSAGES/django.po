msgstr "Cara pelanggan memilih mata uang pilihan mereka"

#: models.py:261
msgid "Show Currency Switcher"
msgstr "Tampilkan Pemilih Mata Uang"

#: models.py:263
msgid ""
"Display currency switcher widget in storefront (only when multi-currency is "
"enabled)"
msgstr ""
"Tampilkan widget pengganti mata uang di toko (hanya ketika multi-mata uang "
"diaktifkan)"

#: models.py:268
