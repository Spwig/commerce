msgstr "Tóm tắt hàng ngày"

#: models.py:1104
msgid "Weekly Summary"
msgstr "Tóm tắt hàng tuần"

#: models.py:1111
msgid "Low Stock Alert Frequency"
msgstr "Tần suất cảnh báo tồn kho thấp"

#: models.py:1112
msgid "How often to send low stock alert notifications"
msgstr "Tần suất gửi thông báo cảnh báo hàng tồn kho thấp"

