msgid "Safety Stock Multiplier"
msgstr "Hệ số tồn kho an toàn"

#: models.py:1133
#, python-format
msgid ""
"Multiplier applied to velocity for safety stock calculation (e.g., 1.5 means "
"50%% buffer)"
msgstr ""
"Hệ số nhân với vận tốc để tính toán hàng dự phòng (ví dụ, 1.5 có nghĩa là "
"50%% đệm)"

