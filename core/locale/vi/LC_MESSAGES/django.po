msgid ""
"Send verification code before enabling SMS notifications (recommended for "
"TCPA compliance)"
msgstr ""
"Gửi mã xác thực trước khi bật thông báo SMS (được khuyến nghị để tuân thủ "
"TCPA)"

#: models.py:1066
msgid "Collect Unsubscribe Reasons"
msgstr "Thu thập lý do hủy đăng ký"

