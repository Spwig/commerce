#: models.py:326 templates/admin/core/sitesettings/change_form.html:810
msgid "Rate Selection Strategy"
msgstr "Chiến lược chọn tỷ giá"

#: models.py:328
msgid ""
"When multiple providers are active: 'Primary' always uses rates from your "
"primary provider (consistent pricing), 'Latest' uses the most recently "
"synced rate from any active provider (freshest data)."
msgstr ""
"Khi có nhiều nhà cung cấp đang hoạt động: 'Chính' luôn sử dụng tỷ giá từ nhà "
"cung cấp chính của bạn (giá cả nhất quán), 'Mới nhất' sử dụng tỷ giá được "
"đồng bộ gần nhất từ bất kỳ nhà cung cấp nào đang hoạt động (dữ liệu mới "
"nhất)."

#: models.py:333
msgid "Real-time (every 15 minutes)"
msgstr "Thực thời (mỗi 15 phút)"

#: models.py:334
msgid "Hourly"
msgstr "Theo giờ"

#: models.py:335
msgid "Daily"
msgstr "Theo ngày"

#: models.py:336
msgid "Weekly"
msgstr "Theo tuần"

#: models.py:337
msgid "Monthly"
msgstr "Theo tháng"

#: models.py:338
msgid "Quarterly"
msgstr "Theo quý"

#: models.py:339
msgid "Manual Only (no auto-sync)"
msgstr "Chỉ thủ công (không đồng bộ tự động)"

#: models.py:346
msgid "Exchange Rate Sync Interval"
msgstr "Khoảng thời gian đồng bộ tỷ giá"

#: models.py:348
msgid ""
"How often to automatically sync exchange rates from providers. 'Manual Only' "
"disables auto-sync; you control rates entirely via manual rates."
msgstr ""
"Tần suất tự động đồng bộ tỷ giá hối đoái từ các nhà cung cấp. 'Chỉ thủ công' "
"sẽ tắt tính năng đồng bộ tự động; bạn sẽ kiểm soát hoàn toàn tỷ giá thông "
"qua tỷ giá thủ công."

#: models.py:354
msgid "Full Multi-Currency (checkout in visitor currency)"
msgstr "Đa tiền tệ đầy đủ (thanh toán bằng tiền tệ của khách truy cập)"

#: models.py:355
msgid "Display Only (show converted prices, charge in base currency)"
msgstr ""
"Chỉ hiển thị (hiển thị giá đã chuyển đổi, thanh toán bằng tiền tệ cơ sở)"

#: models.py:362
msgid "Multi-Currency Checkout Mode"
msgstr "Chế độ thanh toán đa tiền tệ"

#: models.py:364
msgid ""
"Full: Customers browse and pay in their selected currency. Display Only: "
"Prices shown in visitor's currency for browsing, but all payments are "
"charged in your base currency with a transparent conversion notice."
msgstr ""
"Toàn bộ: Khách hàng duyệt và thanh toán bằng đồng tiền đã chọn của họ. Chỉ "
"hiển thị: Giá được hiển thị bằng đồng tiền của khách truy cập khi duyệt, "
"nhưng tất cả các thanh toán sẽ được tính bằng đồng tiền cơ bản của bạn với "
"thông báo chuyển đổi minh bạch."

#: models.py:415
msgid "Before Checkout (Step 1) - Not Recommended"
msgstr "Trước khi thanh toán (Bước 1) - Không được khuyến khích"

#: models.py:416
msgid "During Checkout (Before Payment)"
msgstr "Trong quá trình thanh toán (Trước khi thanh toán)"

#: models.py:417
msgid "After Purchase - Recommended"
msgstr "Sau khi mua hàng - Được khuyến nghị"

#: models.py:424
msgid "Account Creation Timing"
msgstr "Thời điểm tạo tài khoản"

#: models.py:426
msgid ""
"When to prompt customers to create an account. 'After Purchase' leverages "
"post-purchase positive emotion for highest conversion. 'During Checkout' "
"creates account before payment. 'Before Checkout' requires account upfront "
"(not recommended - reduces conversion)."
msgstr ""
"Khi nào nhắc khách hàng tạo tài khoản. 'Sau khi mua hàng' tận dụng cảm xúc "
"tích cực sau khi mua hàng để đạt tỷ lệ chuyển đổi cao nhất. 'Trong quá trình "
"thanh toán' tạo tài khoản trước khi thanh toán. 'Trước khi thanh toán' yêu "
"cầu tài khoản trước (không được khuyến khích - làm giảm tỷ lệ chuyển đổi)."

#: models.py:436
msgid "Account Creation Message"
msgstr "Thông điệp tạo tài khoản"

#: models.py:438
msgid ""
"Custom message explaining why creating an account is beneficial. Supports "
"translations. Default: 'Create an account to track your order, save "
"addresses, and enjoy faster checkout next time!'"
msgstr ""
"Thông điệp tùy chỉnh giải thích lý do tạo tài khoản là hữu ích. Hỗ trợ đa "
"ngôn ngữ. Mặc định: 'Tạo tài khoản để theo dõi đơn hàng của bạn, lưu địa chỉ "
"và tận hưởng trải nghiệm thanh toán nhanh hơn lần sau!'"

#: models.py:446
msgid "Show Social Authentication Options"
msgstr "Hiển thị tùy chọn xác thực xã hội"

#: models.py:448
msgid ""
"Display social login buttons (Google, Apple, Microsoft) during account "
"creation if configured in OAuth Provider Settings."
msgstr ""
"Hiển thị nút đăng nhập mạng xã hội (Google, Apple, Microsoft) khi tạo tài "
"khoản nếu đã cấu hình trong Cài đặt Cung cấp OAuth."

#: models.py:472
msgid "Live - Deliver emails normally"
msgstr "Sử dụng - Gửi email bình thường"

#: models.py:473
msgid "Paused - Hold emails for later delivery"
msgstr "Tạm dừng - Giữ email để giao sau"

#: models.py:474
msgid "Log Only - Record emails but never deliver"
msgstr "Chỉ ghi nhật ký - Ghi lại email nhưng không bao giờ giao"

#: models.py:481 templates/admin/core/sitesettings/change_form.html:389
msgid "Email Delivery Mode"
msgstr "Chế độ giao email"

#: models.py:483
msgid ""
"Controls how outgoing emails are handled. 'Live' delivers normally. 'Paused' "
"holds emails until you switch back to Live. 'Log Only' records emails in the "
"outbox for review but never sends them."
msgstr ""
"Kiểm soát cách xử lý các email gửi đi. 'Live' gửi email bình thường. "
"'Paused' giữ email lại cho đến khi bạn chuyển lại sang chế độ Live. 'Log "
"Only' ghi lại email trong hộp thư gửi để xem nhưng không bao giờ gửi chúng."

#: models.py:492
msgid "Test Redirect Email"
msgstr "Email chuyển hướng kiểm tra"

#: models.py:494
msgid ""
"When set, ALL outgoing emails are redirected to this address instead of the "
"real recipient. Useful for testing email templates and flows. Leave blank to "
"send to actual recipients."
msgstr ""
"Khi được thiết lập, TẤT CẢ các email gửi đi sẽ được chuyển hướng đến địa chỉ "
"này thay vì người nhận thực tế. Hữu ích để kiểm tra các mẫu email và quy "
"trình. Để trống để gửi đến người nhận thực tế."

#: models.py:503
msgid "Sandbox Email Whitelist"
msgstr "Danh sách email trắng Sandbox"

#: models.py:505
msgid ""
"In sandbox mode, only emails to these addresses will be delivered. All other "
"emails are logged but never sent. The admin email is always included "
"automatically. Maximum 10 addresses."
msgstr ""
"Trong chế độ sandbox, chỉ các email gửi đến các địa chỉ này mới được giao. "
"Tất cả các email khác sẽ được ghi lại nhưng không bao giờ được gửi. Địa chỉ "
"email quản trị viên luôn được bao gồm tự động. Tối đa 10 địa chỉ."

#: models.py:514
msgid "Sandbox SMS Whitelist"
msgstr "Danh sách SMS trắng Sandbox"

#: models.py:516
msgid ""
"In sandbox mode, only SMS messages to these phone numbers will be sent. All "
"other messages are logged but never delivered. Use E.164 format (e.g., "
"+1234567890). Maximum 5 numbers."
msgstr ""
"Trong chế độ sandbox, chỉ có tin nhắn SMS đến các số điện thoại này sẽ được "
"gửi. Tất cả tin nhắn khác sẽ được ghi lại nhưng không bao giờ được gửi đi. "
"Sử dụng định dạng E.164 (ví dụ: +1234567890). Tối đa 5 số."

#: models.py:563
msgid "Maintenance Page"
msgstr "Trang bảo trì"

#: models.py:565
msgid ""
"Custom page displayed when maintenance mode is enabled. Edit this page in "
"Page Builder to customize the maintenance experience."
msgstr ""
"Trang tùy chỉnh được hiển thị khi chế độ bảo trì được bật. Chỉnh sửa trang "
"này trong Page Builder để tùy chỉnh trải nghiệm bảo trì."

#: models.py:572
msgid "Enable Error Reporting"
msgstr "Kích hoạt báo cáo lỗi"

#: models.py:574
msgid ""
"Automatically send anonymized error reports to Spwig to help improve the "
"platform. No personal data is ever transmitted."
msgstr ""
"Gửi tự động các báo cáo lỗi đã được làm ẩn danh đến Spwig để giúp cải thiện "
"nền tảng. Không bao giờ truyền dữ liệu cá nhân."

#: models.py:579
msgid "Include JavaScript Errors"
msgstr "Bao gồm lỗi JavaScript"

#: models.py:581
msgid ""
"Also capture and report JavaScript errors from the storefront and admin "
"interface."
msgstr ""
"Cũng hãy bắt lỗi và báo cáo các lỗi JavaScript từ cửa hàng và giao diện quản "
"trị."

#: models.py:588
msgid "Enable Shipping Labels"
msgstr "Kích hoạt nhãn vận chuyển"

#: models.py:598
msgid "Default Shipping Provider"
msgstr "Nhà cung cấp vận chuyển mặc định"

#: models.py:608
msgid "Default Manual Carrier"
msgstr "Nhà vận chuyển thủ công mặc định"

#: models.py:615
msgid "Shipping Origin Country"
msgstr "Quốc gia xuất xứ vận chuyển"

#: models.py:666
msgid "Default Weight Unit"
msgstr "Đơn vị trọng lượng mặc định"

#: models.py:674
msgid "Default Length Unit"
msgstr "Đơn vị chiều dài mặc định"

#: models.py:682
msgid "Default Volume Unit"
msgstr "Đơn vị thể tích mặc định"

#: models.py:690
msgid "Default Area Unit"
msgstr "Đơn vị diện tích mặc định"

#: models.py:698
msgid "Default Temperature Unit"
msgstr "Đơn vị nhiệt độ mặc định"

#: models.py:704
msgid "Enable Unit Conversion for Customers"
msgstr "Kích hoạt chuyển đổi đơn vị cho khách hàng"

#: models.py:749
msgid "Optional - Staff can choose to enable 2FA"
msgstr "Tùy chọn - Nhân viên có thể chọn bật 2FA"

#: models.py:750
msgid "Recommended - Prompt staff to enable 2FA"
msgstr "Khuyến nghị - Nhắc nhở nhân viên bật 2FA"

#: models.py:751
msgid "Required - Staff must enable 2FA to access admin"
msgstr "Bắt buộc - Nhân viên phải bật 2FA để truy cập bảng điều khiển quản trị"

#: models.py:758
msgid "Staff 2FA Enforcement"
msgstr "Áp dụng 2FA cho nhân viên"

#: models.py:759
msgid "Control whether two-factor authentication is required for admin access"
msgstr ""
"Kiểm soát xem xác thực hai yếu tố có phải là điều kiện bắt buộc để truy cập "
"bảng điều khiển quản trị hay không"

#: models.py:764
msgid "2FA Setup Grace Period (Days)"
msgstr "Thời gian ân hạn thiết lập 2FA (Ngày)"

#: models.py:766 templates/admin/core/sitesettings/change_form.html:1243
msgid ""
"Days allowed for staff to set up 2FA after enforcement is enabled. Set to 0 "
"for immediate enforcement."
msgstr ""
"Số ngày cho phép nhân viên thiết lập 2FA sau khi chế độ bắt buộc được bật. "
"Đặt thành 0 để áp dụng ngay lập tức."

#: models.py:773
msgid "2FA Enforcement Start Date"
msgstr "Ngày bắt đầu áp dụng 2FA"

#: models.py:774
msgid ""
"When 2FA enforcement was enabled. Used to calculate grace period expiration."
msgstr ""
"Khi chế độ bắt buộc 2FA được bật. Được sử dụng để tính toán thời gian ân hạn "
"hết hạn."

#: models.py:779
msgid "Allow Trusted Devices"
msgstr "Cho phép thiết bị đáng tin cậy"

#: models.py:780
msgid "Allow users to mark devices as trusted to skip 2FA for a period"
msgstr ""
"Cho phép người dùng đánh dấu thiết bị là đáng tin cậy để bỏ qua 2FA trong "
"một khoảng thời gian"

#: models.py:785
msgid "Trusted Device Duration (Days)"
msgstr "Thời gian hiệu lực thiết bị đáng tin cậy (Ngày)"

#: models.py:786
msgid ""
"How long a device stays trusted after 'Remember this device' is selected"
msgstr ""
"Thiết bị được đánh dấu là đáng tin cậy trong bao lâu sau khi chọn 'Ghi nhớ "
"thiết bị này'"

#: models.py:794
msgid "Enable SSO for Admin Login"
msgstr "Bật SSO cho đăng nhập quản trị"

#: models.py:795
msgid "Show enterprise SSO button on the admin login page"
msgstr "Hiển thị nút SSO doanh nghiệp trên trang đăng nhập admin"

#: models.py:799
msgid "Allow Password Login"
msgstr "Cho phép đăng nhập bằng mật khẩu"

#: models.py:801
msgid ""
"Allow password-based login on the admin page. Disable to enforce SSO-only "
"access."
msgstr ""
"Cho phép đăng nhập bằng mật khẩu trên trang admin. Tắt để bắt buộc chỉ truy "
"cập qua SSO."

#: models.py:810
msgid "Maximum Devices Per User"
msgstr "Số thiết bị tối đa mỗi người dùng"

#: models.py:812
msgid ""
"Maximum number of mobile devices each staff member can have registered "
"simultaneously. Set to 0 for unlimited devices."
msgstr ""
"Số lượng tối đa thiết bị di động mỗi nhân viên có thể đăng ký đồng thời. Đặt "
"thành 0 để không giới hạn thiết bị."

#: models.py:827
msgid "Home Page"
msgstr "Trang chủ"

#: models.py:828
msgid "The main landing page of your store"
msgstr "Trang chủ chính của cửa hàng bạn"

#: models.py:837
msgid "Privacy Policy Page"
msgstr "Trang chính sách bảo mật"

#: models.py:838
msgid "Your store's privacy policy"
msgstr "Chính sách bảo mật của cửa hàng bạn"

#: models.py:846
msgid "Terms of Use Page"
msgstr "Trang điều khoản sử dụng"

#: models.py:847
msgid "Your store's terms of service/use"
msgstr "Điều khoản dịch vụ/sử dụng của cửa hàng bạn"

#: models.py:855 templates/admin/core/sitesettings/change_form.html:1758
msgid "Cookie Policy Page"
msgstr "Trang chính sách cookie"

#: models.py:856
msgid "Your store's cookie policy"
msgstr "Chính sách cookie của cửa hàng bạn"

#: models.py:864
msgid "Shipping Information Page"
msgstr "Trang thông tin vận chuyển"

#: models.py:865
msgid "Shipping policies and delivery information"
msgstr "Chính sách vận chuyển và thông tin giao hàng"

#: models.py:873
msgid "Returns Policy Page"
msgstr "Trang Chính sách Trả hàng"

#: models.py:874
msgid "Return and refund policies"
msgstr "Chính sách trả hàng và hoàn tiền"

#: models.py:882
msgid "Enable Cookie Consent Banner"
msgstr "Bật banner đồng ý Cookie"

#: models.py:883
msgid "Show a GDPR-compliant cookie consent banner to visitors."
msgstr "Hiển thị bảng đồng ý cookie tuân thủ GDPR cho khách truy cập."

#: models.py:887
msgid "Bottom Bar"
msgstr "Thanh dưới cùng"

#: models.py:888
msgid "Bottom Left"
msgstr "Phía dưới bên trái"

#: models.py:889
msgid "Bottom Right"
msgstr "Phía dưới bên phải"

#: models.py:896
msgid "Banner Position"
msgstr "Vị trí banner"

#: models.py:897
msgid "Where to display the cookie consent banner on screen."
msgstr "Nơi hiển thị bảng đồng ý cookie trên màn hình."

#: models.py:901
msgid "Simple — Accept / Reject only"
msgstr "Đơn giản — Chỉ chấp nhận / Từ chối"

#: models.py:902
msgid "Granular — Per-category control"
msgstr "Chi tiết — Kiểm soát theo danh mục"

#: models.py:909
msgid "Consent Mode"
msgstr "Chế độ đồng ý"

#: models.py:911
msgid ""
"'Simple' shows Accept/Reject buttons only. 'Granular' adds a Manage "
"Preferences option for per-category control."
msgstr ""
"'Đơn giản' chỉ hiển thị nút Chấp nhận/Từ chối. 'Chi tiết' thêm tùy chọn Quản "
"lý Lựa chọn để điều chỉnh theo từng danh mục."

#: models.py:920
msgid "Banner Title"
msgstr "Tiêu đề banner"

#: models.py:921
msgid "Short heading for the cookie banner. Supports translations."
msgstr "Tiêu đề ngắn cho bảng cookie. Hỗ trợ dịch thuật."

#: models.py:927
msgid "Banner Description"
msgstr "Mô tả banner"

#: models.py:928
msgid "Main body text explaining cookie usage. Supports translations."
msgstr "Văn bản chính giải thích việc sử dụng cookie. Hỗ trợ dịch thuật."

#: models.py:934
msgid "Analytics Cookies Description"
msgstr "Mô tả cookie phân tích"

#: models.py:936
msgid ""
"Describe what analytics cookies do (shown in granular mode). Supports "
"translations."
msgstr ""
"Mô tả việc cookie phân tích làm gì (hiển thị ở chế độ chi tiết). Hỗ trợ dịch "
"thuật."

#: models.py:943
msgid "Marketing Cookies Description"
msgstr "Mô tả cookie quảng cáo"

#: models.py:945
msgid ""
"Describe what marketing cookies do (shown in granular mode). Supports "
"translations."
msgstr ""
"Mô tả việc cookie quảng cáo làm gì (hiển thị ở chế độ chi tiết). Hỗ trợ dịch "
"thuật."

#: models.py:952
msgid "Functional Cookies Description"
msgstr "Mô tả cookie chức năng"

#: models.py:954
msgid ""
"Describe what functional cookies do (shown in granular mode). Supports "
"translations."
msgstr ""
"Mô tả việc cookie chức năng làm gì (hiển thị ở chế độ chi tiết). Hỗ trợ dịch "
"thuật."

#: models.py:965
msgid "404 Error Page"
msgstr "Trang Lỗi 404"

#: models.py:966
msgid "Custom page for 'page not found' errors"
msgstr "Trang tùy chỉnh cho lỗi 'trang không tìm thấy'"

#: models.py:974
msgid "500 Error Page"
msgstr "Trang Lỗi 500"

#: models.py:975
msgid "Custom page for server errors"
msgstr "Trang tùy chỉnh cho lỗi máy chủ"

#: models.py:982
msgid "Cover - Fill dimensions (crops if needed)"
msgstr "Bao phủ - Điền kích thước (cắt nếu cần)"

#: models.py:983
msgid "Contain - Fit within dimensions"
msgstr "Chứa - Phù hợp với kích thước"

#: models.py:984
msgid "Pad - Fit and add padding (preserves all content)"
msgstr "Đệm - Phù hợp và thêm khoảng trống (bảo tồn toàn bộ nội dung)"

#: models.py:988
msgid "Transparent"
msgstr "Trong suốt"

#: models.py:989
msgid "White"
msgstr "Trắng"

#: models.py:990
msgid "Black"
msgstr "Đen"

#: models.py:997
msgid "Default Image Resize Mode"
msgstr "Chế độ điều chỉnh kích thước hình ảnh mặc định"

#: models.py:999
msgid ""
"How images are resized when generating thumbnails. 'Cover' crops to fill "
"dimensions, 'Contain' fits within dimensions, 'Pad' preserves all content "
"with padding."
msgstr ""
"Cách hình ảnh được điều chỉnh kích thước khi tạo ảnh thu nhỏ. 'Cover' cắt để "
"lấp đầy kích thước, 'Contain' phù hợp trong kích thước, 'Pad' bảo tồn toàn "
"bộ nội dung với khoảng trống."

#: models.py:1007
msgid "Default Padding Color"
msgstr "Màu độ giãn mặc định"

#: models.py:1009
msgid ""
"Background color for padding when using 'Pad' resize mode. Transparent works "
"best for logos."
msgstr ""
"Màu nền cho khoảng trống khi sử dụng chế độ điều chỉnh kích thước 'Pad'. Màu "
"trong suốt hoạt động tốt nhất cho logo."

#: models.py:1017
msgid "Logo Resize Mode"
msgstr "Chế độ điều chỉnh kích thước logo"

#: models.py:1018
msgid ""
"How logos are resized. 'Pad' is recommended to preserve full logo content."
msgstr ""
"Cách logo được điều chỉnh kích thước. 'Pad' được khuyến nghị để bảo tồn toàn "
"bộ nội dung của logo."

#: models.py:1025
msgid "Logo Padding Color"
msgstr "Màu độ giãn logo"

#: models.py:1027
msgid ""
"Background color for logo padding. Transparent preserves the logo background."
msgstr "Màu nền cho khoảng cách logo. Trong suốt sẽ giữ nguyên nền logo."

#: models.py:1034
msgid "Enable Double Opt-In for Marketing Emails"
