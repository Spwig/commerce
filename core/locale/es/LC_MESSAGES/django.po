#: templates/admin/core/sitesettings/change_form.html:397
msgid ""
"Email delivery is currently paused. Emails will be held and released when "
"you switch back to Live."
msgstr ""
"La entrega de correos electrónicos está pausada actualmente. Los correos "
"electrónicos se mantendrán y se liberarán cuando cambie de nuevo a \"Live\"."

