#: models.py:441
msgid "Prevent customers from removing this element."
msgstr "Ngăn khách hàng xóa phần tử này."

#: models.py:445 templates/admin/customizable_product/template_editor.html:186
msgid "Lock Rotation"
msgstr "Khóa xoay"

