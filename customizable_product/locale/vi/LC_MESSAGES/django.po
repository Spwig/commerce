#: models.py:425 templates/admin/customizable_product/template_editor.html:180
msgid "Lock Position"
msgstr "Khóa vị trí"

#: models.py:426
msgid "Prevent customers from moving this element."
msgstr "Ngăn khách hàng di chuyển phần tử này."

#: models.py:430 templates/admin/customizable_product/template_editor.html:183
msgid "Lock Size"
msgstr "Khóa kích thước"

