"Could not auto-generate DKIM keys. You may need to generate them manually "
"later."
msgstr "无法自动生成DKIM密钥。您可能需要稍后手动生成。"

#: views/wizard.py:904
msgid "Please complete sender configuration first."
msgstr "请先完成发件人配置。"

#: views/wizard.py:929 views/wizard.py:1101 views/wizard.py:1218
msgid "Email Provider Setup - DNS Configuration"
msgstr "电子邮件服务提供商设置 - DNS配置"

#: views/wizard.py:1243
msgid ""
"Spwig could not load the DNS configuration for this email provider. Please "
"try again, or contact support if the problem continues."
msgstr "Spwig 无法加载此电子邮件提供商的 DNS 配置。请重试，如果问题持续，请联系支持团队。"

#: views/wizard.py:1262
msgid "Domain updated. DNS validation refreshed."
msgstr "域名已更新。DNS验证已刷新。"

#: views/wizard.py:1264
msgid "Invalid domain format."
msgstr "域名格式无效。"

#: views/wizard.py:1277
msgid ""
"DNS validation incomplete. Your emails may be flagged as spam until DNS "
"records are properly configured."
msgstr "DNS验证未完成。在正确配置DNS记录之前，您的电子邮件可能会被标记为垃圾邮件。"

#: views/wizard.py:1303
msgid "Please complete previous steps first."
msgstr "请先完成之前的步骤。"

#: views/wizard.py:1307
msgid "Email Provider Setup - Test Send"
msgstr "电子邮件服务提供商设置 - 测试发送"

#: views/wizard.py:1320
msgid "Please enter a test recipient email."
msgstr "请输入测试收件人电子邮件。"

#: views/wizard.py:1330
msgid "Please enter a valid email address."
msgstr "请输入有效的电子邮件地址。"

#: views/wizard.py:1346
msgid "Built-in SMTP server could not be started. Please check the logs."
msgstr "内置SMTP服务器无法启动。请检查日志。"

#: views/wizard.py:1363
msgid "⚠ Postfix mail server is not running. Email delivery will fail."
msgstr "⚠ Postfix邮件服务器未运行。电子邮件将无法发送。"

#: views/wizard.py:1368
msgid ""
"For Docker: Check container logs. For development: Run \"sudo postfix "
"start\""
msgstr "对于Docker：检查容器日志。对于开发环境：运行 \"sudo postfix start\""

#: views/wizard.py:1389
#, python-format
msgid "Provider not found: %(key)s"
msgstr "未找到提供商：%(key)s"

#: views/wizard.py:1410
msgid ""
"Spwig Email credentials have not been provisioned yet. Please contact "
"support."
msgstr "Spwig 邮件凭证尚未配置。请联系支持团队。"

#: views/wizard.py:1416
msgid "Could not load email credentials."
msgstr "无法加载电子邮件凭据。"

#: views/wizard.py:1422
msgid "OAuth authentication not completed. Please go back to Step 2."
msgstr "OAuth认证未完成。请返回步骤2。"

#: views/wizard.py:1430
#, python-format
msgid "Test Email from %(name)s"
msgstr "来自 %(name)s 的测试邮件"

#: views/wizard.py:1535
#, python-format
msgid "✓ Test email sent successfully to %(email)s! Check your inbox."
msgstr "✓ 测试邮件已成功发送至 %(email)s！请查看您的收件箱。"

#: views/wizard.py:1541
#, python-format
msgid "Message ID: %(id)s"
msgstr "消息 ID：%(id)s"

#: views/wizard.py:1552
msgid "Unknown error"
msgstr "未知错误"

#: views/wizard.py:1554
#, python-format
msgid "Failed to send test email: %(error)s"
msgstr "发送测试邮件失败：%(error)s"

#: views/wizard.py:1560
#, python-format
msgid "Error sending test email: %(error)s"
msgstr "发送测试邮件时出错：%(error)s"

#: views/wizard.py:1578
msgid "Please complete all previous steps."
msgstr "请完成所有之前的步骤。"

#: views/wizard.py:1617
msgid "Email Provider Setup - Complete"
msgstr "电子邮件提供商设置 - 完成"

#: views/wizard.py:1628
#, python-format
msgid "Error: %(error)s"
msgstr "错误：%(error)s"

