msgid "Create OAuth Credentials"
msgstr "OAuth認証情報を作成"

#: templates/email_system/oauth_setup.html:114
msgid ""
"Go to APIs & Services → Credentials → Create Credentials → OAuth client ID"
msgstr ""
"APIs & Services → Credentials → Credentialsを作成 → OAuth client IDに移動してください。"

#: templates/email_system/oauth_setup.html:115
msgid "Select 'Web application' and add the redirect URI shown above"
msgstr "「Web application」を選択し、上記に表示されているリダイレクトURIを追加してください。"

