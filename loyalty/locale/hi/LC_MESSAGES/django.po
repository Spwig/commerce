msgstr "एकल ऑर्डर मूल्य - उच्च मूल्य वाला एकल ऑर्डर दिया।"

#: models.py:561
msgid "Items Per Order - Order with many items"
msgstr "ऑर्डर प्रति आइटम - कई आइटम वाला ऑर्डर।"

#: models.py:562
msgid "Orders Per Month - Multiple orders in one month"
msgstr "एक महीने में ऑर्डर - एक महीने में कई ऑर्डर।"

#: models.py:576
msgid ""
"Target value for achievement. Examples: 5 for '5 orders', 100 for '$100 "
"spent', 3 for '3 consecutive months', etc."
msgstr ""
"उपलब्धि के लिए लक्ष्य मूल्य। उदाहरण: '5 ऑर्डर' के लिए 5, '$100 खर्च' के लिए 100, '3 "
"क्रमागत महीने' के लिए 3 आदि।"

#: models.py:1135
msgid "Discount type is required for discount rewards."
msgstr "छूट के प्रकार के लिए छूट पुरस्कार की आवश्यकता होती है।"

#: models.py:1140
msgid "Discount value is required for discount rewards."
msgstr "छूट पुरस्कार के लिए छूट मूल्य आवश्यक है।"

#: models.py:1147
msgid "Percentage discount cannot exceed 100%."
msgstr "प्रतिशत छूट 100% से अधिक नहीं हो सकता।"

#: models.py:1151 models.py:1158
msgid "Discount value must be greater than 0."
msgstr "छूट मूल्य 0 से अधिक होना चाहिए।"

#: models.py:1164
msgid "Product selection is required for product rewards."
msgstr "उत्पाद पुरस्कार के लिए उत्पाद चयन आवश्यक है।"

#: models.py:1171
msgid "Quantity remaining cannot exceed total quantity."
msgstr "शेष मात्रा कुल मात्रा से अधिक नहीं हो सकती।"

