msgstr "Hanya pesanan yang sudah diterima yang dapat dikembalikan"

#: views.py:689
#, python-format
msgid "Return quantity cannot exceed ordered quantity for item %(sku)s"
msgstr ""
"Jumlah pengembalian tidak boleh melebihi jumlah yang dipesan untuk item "
"%(sku)s"

#: views.py:708
#, python-format
msgid "Invalid order item ID: %(id)s"
msgstr "ID item pesanan tidak valid: %(id)s"

#: views.py:735
msgid ""
"Return request created successfully. We will review your request and send "
"you a return label."
msgstr ""
"Permintaan pengembalian berhasil dibuat. Kami akan meninjau permintaan Anda "
"dan mengirimkan label pengembalian."

#: views.py:759
msgid "Return label has not been generated yet. Please wait for approval."
msgstr "Label pengembalian belum dihasilkan. Tunggu persetujuan."

#: views.py:767
msgid "Return label is not available"
msgstr "Label pengembalian tidak tersedia"

#: views.py:844
msgid "Product is required"
msgstr "Produk diperlukan"

#: views.py:850
msgid "Product not found"
msgstr "Produk tidak ditemukan"

#: views.py:859
msgid "Product variant not found"
msgstr "Varian produk tidak ditemukan"

#: views.py:868
msgid "Invalid quantity"
msgstr "Kuantitas tidak valid"

#: views.py:880
#, python-format
msgid "Invalid price format: %(error)s"
msgstr "Format harga tidak valid: %(error)s"

#: views.py:916
msgid "Item added successfully"
msgstr "Item berhasil ditambahkan"

#: views.py:927
msgid "Error adding item. Please try again."
msgstr "Kesalahan menambahkan item. Silakan coba lagi."

#: views.py:1006
msgid "Item updated successfully"
msgstr "Item berhasil diperbarui"

#: views.py:1017
msgid "Error updating item. Please try again."
msgstr "Kesalahan memperbarui item. Silakan coba lagi."

#: views.py:1065
msgid "Item removed successfully"
msgstr "Item berhasil dihapus"

#: views.py:1074
msgid "Error removing item. Please try again."
msgstr "Kesalahan menghapus item. Silakan coba lagi."

#: views.py:1115
msgid "Error recalculating totals. Please try again."
msgstr "Kesalahan menghitung ulang total. Silakan coba lagi."

#: views.py:1272
msgid "Please provide discount type and value."
msgstr "Silakan berikan jenis diskon dan nilai."

#: views.py:1282
msgid "Invalid discount value."
msgstr "Nilai diskon tidak valid."

#: views.py:1291
msgid "Percentage discount cannot exceed 100%."
msgstr "Diskon persentase tidak dapat melebihi 100%."

#: views.py:1307
msgid "Discount amount cannot exceed order subtotal."
msgstr "Jumlah diskon tidak dapat melebihi subtotal pesanan."

#: views.py:1313
msgid "Invalid discount type."
msgstr "Jenis diskon tidak valid."

#: views.py:1340
#, python-brace-format
msgid "Manual discount of {discount} applied successfully."
msgstr "Diskon manual sebesar {discount} telah diterapkan secara berhasil."

#: views.py:1360
msgid "Error applying discount. Please try again."
msgstr "Kesalahan menerapkan diskon. Silakan coba lagi."

#: views.py:1581
msgid "Customer updated successfully"
msgstr "Pelanggan berhasil diperbarui"

#: views.py:1603
msgid "Error updating customer. Please try again."
msgstr "Kesalahan memperbarui pelanggan. Silakan coba lagi."

#: views.py:1688
msgid "Customer addresses populated to order"
msgstr "Alamat pelanggan diisi ke pesanan"

#: views.py:1704
msgid "Addresses populated successfully"
msgstr "Alamat berhasil diisi"

#: views.py:1714
msgid "Error populating addresses. Please try again."
msgstr "Kesalahan mengisi alamat. Silakan coba lagi."

#: views.py:1764
#, python-format
msgid "%(type)s address updated"
msgstr "Alamat %(type)s diperbarui"

#: views.py:1788
msgid "Error updating address. Please try again."
msgstr "Kesalahan memperbarui alamat. Silakan coba lagi."

#: views.py:1822
#, python-format
msgid "Status changed from %(old)s to %(new)s"
msgstr "Status berubah dari %(old)s ke %(new)s"

#: views.py:1856
msgid "Error updating status. Please try again."
msgstr "Kesalahan memperbarui status. Silakan coba lagi."

#: views.py:1880
msgid "Please enter at least 2 characters to search"
msgstr "Silakan masukkan setidaknya 2 karakter untuk mencari"

