msgid "The upgrade process may take several minutes."
msgstr "Quy trình nâng cấp có thể mất một vài phút."

#: templates/admin/management/upgrade.html:111
msgid "If something goes wrong, you can roll back to the backup."
msgstr "Nếu xảy ra sự cố, bạn có thể quay lại bản sao lưu."

#: templates/admin/management/upgrade.html:112
msgid "Do not close this page or navigate away during the upgrade."
msgstr "Đừng đóng trang này hoặc rời khỏi trang trong khi nâng cấp."

